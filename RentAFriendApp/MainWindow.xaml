<Window x:Class="RentAFriendApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RentAFriendApp"
        mc:Ignorable="d"
        Title="RentAFriend" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA">
    <Window.Resources>
        <!-- Стили для навигационных кнопок -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F5E8"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для активной кнопки -->
        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#E8F5E8"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="0,0,3,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <!-- Верхняя шапка -->
        <Border Height="60" Background="White" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border Width="32" Height="32" CornerRadius="8" 
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Image Source="/Resources/Images/rentiIco.png"/>
                    </Border>
                    <TextBlock Text="RentAFriend" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#333333"/>
                </StackPanel>

                <StackPanel Cursor="Hand"
                            MouseDown="Profile_Click"
                            Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" 
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="36" Height="36" Background="#E8F5E8" CornerRadius="18"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CurrentUserInitial}" 
                                   Foreground="#4CAF50" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="CurrentUserName" Text="Иван Клиентов" 
                                   FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock x:Name="CurrentUserRole" Text="Клиент" 
                                   FontSize="12" Foreground="#666666"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                    <Grid Cursor="Hand" MouseDown="BtnNotifications_Click" Margin="0,0,16,0">
                        <Border Width="36" Height="36" Background="#F5F5F5" CornerRadius="18"
                            VerticalAlignment="Center">
                            <TextBlock Text="🔔" FontSize="18" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="NotificationBadge" 
                            Width="18" Height="18" 
                            Background="#FF5252" CornerRadius="9"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-2,-2,0"
                            Visibility="Collapsed">
                            <TextBlock x:Name="BadgeCount" Text="0"
                            FontSize="10" FontWeight="Bold" Foreground="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Border Width="36" Height="36" Background="#F5F5F5" CornerRadius="18"
                            Cursor="Hand" MouseDown="BtnBurger_Click"
                            VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="16" Height="2" Background="#666666" CornerRadius="1" Margin="0,0,0,3"/>
                            <Border Width="16" Height="2" Background="#666666" CornerRadius="1" Margin="0,0,0,3"/>
                            <Border Width="16" Height="2" Background="#666666" CornerRadius="1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Popup x:Name="BurgerMenuPopup" 
                    PlacementTarget="{Binding ElementName=MainGrid}"
                    Placement="Right"
                    HorizontalOffset="-230" 
                    VerticalOffset="60"
                    Height="Auto"
                    StaysOpen="False"
                    AllowsTransparency="True">
                    <Border Background="White" CornerRadius="12" Width="220"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.12"/>
                        </Border.Effect>
                        <StackPanel Margin="4">
                            <Button x:Name="BtnMenuNotifications" 
                            Content="🔔  Уведомления" 
                            Style="{StaticResource NavButtonStyle}"
                            Height="44"
                            FontSize="14"
                            Click="BtnMenuNotifications_Click"/>
                            <Border Height="1" Background="#F0F0F0" Margin="8,4"/>
                            <Button Height="44"
                                Style="{StaticResource NavButtonStyle}"
                                Foreground="#FF5252"
                                Click="BtnMenuLogout_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/Icons/exit.png" 
                                    Width="16" Height="16" 
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="Выйти" 
                                    FontSize="14" 
                                    VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="NotificationPopup" 
                        PlacementTarget="{Binding ElementName=MainGrid}"
                        Placement="Right"
                        HorizontalOffset="-390" VerticalOffset="60"
                        StaysOpen="False"
                        AllowsTransparency="True"
                        Width="380"/>
            </Grid>
        </Border>

        <Grid Margin="0,60,0,0">
            <Border Background="White" Margin="10">
                <Frame x:Name="MainFrame" 
                       NavigationUIVisibility="Hidden"
                       BorderThickness="0"/>
            </Border>
        </Grid>
    </Grid>
</Window>
