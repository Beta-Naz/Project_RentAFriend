<UserControl x:Class="RentAFriendApp.Views.Friend.Controls.TimeSlotItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RentAFriendApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="500">

    <UserControl.Resources>
        <converters:StringToTimeSpanConverter x:Key="StringToTimeSpanConverter"/>
        <Style x:Key="TimeSlotStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FDF9"/>
            <Setter Property="BorderBrush" Value="#E8F5E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MainBorder">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource TimeSlotStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBooked}" Value="True">
                        <Setter Property="Background" Value="#FFF5F5"/>
                        <Setter Property="BorderBrush" Value="#FFCDD2"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsBooked}" Value="False"/>
                            <Condition Binding="{Binding IsAvailable}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#F0F9F0"/>
                        <Setter Property="BorderBrush" Value="#C8E6C9"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsBooked}" Value="False"/>
                            <Condition Binding="{Binding IsAvailable}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#F9F9F9"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="Opacity" Value="0.7"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Path Data="{Binding StatusIcon}" 
                          Fill="{Binding StatusColor}" 
                          Stretch="Uniform" 
                          Width="16" 
                          Height="16"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StartTime, Converter={StaticResource StringToTimeSpanConverter}}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#333333"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="до" 
                               FontSize="13"
                               Foreground="#999999"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding EndTime, Converter={StaticResource StringToTimeSpanConverter}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#666666"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Status}" 
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{Binding StatusColor}"/>
                <TextBlock Text="{Binding DurationDisplay}" 
                           FontSize="13"
                           Foreground="#666666"
                           Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M16.5,16.5h-9v-9h9V16.5z" 
                          Fill="#999999" 
                          Stretch="Uniform" 
                          Width="12" 
                          Height="12"
                          Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TimeRange}" 
                               FontSize="12"
                               Foreground="#999999"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Width="35"
                        Height="35"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ToggleButton_Click">
                    <Image Source="{Binding IconsToggle}"
                           Width="30" 
                           Height="30"/>
                </Button>

                <Button Width="35"
                        Height="35"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="DeleteButton_Click">
                    <Image Source="/RentAFriendApp;component/Resources/Icons/delete_ico.png" 
                           Width="30" 
                           Height="30"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>