<Page x:Class="RentAFriendApp.Views.Friend.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RentAFriendApp.Views.Friend"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Профиль"
      Background="#F8F9FA">

    <Page.Resources>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка профиля -->
            <Border Grid.Row="0" 
                    Background="White" 
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Аватар -->
                    <Border Grid.Column="0"
                            Width="100"
                            Height="100"
                            Background="#E8F5E8"
                            CornerRadius="50"
                            Margin="0,0,25,0">
                        <TextBlock Text="{Binding Initials}" 
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Основная информация -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding FullName}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#333333"/>
                            <Border Background="{Binding VerificationStatusColor}" 
                                    CornerRadius="4" 
                                    Padding="8,4"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4L9,16.2z" 
                                          Fill="White" 
                                          Width="14" 
                                          Height="14"
                                          Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding VerificationStatus}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12ZM12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z" 
                                  Fill="#666666" 
                                  Width="22" 
                                  Height="20"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding City}" 
                                       FontSize="14"
                                       Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Path Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4L9,16.2z" 
                                  Fill="#FFC107" 
                                  Width="22" 
                                  Height="20"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"/>
                            <TextBlock VerticalAlignment="Center"
                                        Text="/5" 
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="2,0,15,0"/>
                            <TextBlock Text="{Binding ReviewsCount, StringFormat={}({0} отзывов)}" 
                                       FontSize="13"
                                       Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Почасовая ставка -->
                    <Border Grid.Column="2"
                            Background="#F9FDF9"
                            CornerRadius="8"
                            BorderBrush="#E8F5E8"
                            BorderThickness="1"
                            Padding="20"
                            Width="150">
                        <StackPanel>
                            <TextBlock Text="Ставка" 
                                       FontSize="13" 
                                       Foreground="#666666"/>
                            <TextBlock Text="{Binding HourlyRate, StringFormat={}{0:C}/час}" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Foreground="#4CAF50"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Основная информация -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: О себе и хобби -->
                <Border Grid.Column="0" 
                        Background="White" 
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="О себе" 
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Border Background="#F9F9F9" 
                                CornerRadius="8" 
                                Padding="15"
                                Margin="0,0,0,25">
                            <TextBlock Text="{Binding Bio}" 
                                       FontSize="14"
                                       Foreground="#333333"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Хобби и интересы" 
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <WrapPanel Margin="0,0,0,15">
                            <ItemsControl ItemsSource="{Binding HobbiesList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F5E8" 
                                                CornerRadius="6" 
                                                Padding="10,8"
                                                Margin="0,0,10,10">
                                            <TextBlock Text="{Binding}" 
                                                       FontSize="13"
                                                       Foreground="#2E7D32"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Правая колонка: Контактная информация -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="12"
                        Padding="25">
                    <StackPanel>
                        <TextBlock Text="Контактная информация" 
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <!-- Email -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Email" 
                                       Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Text="{Binding Email}" 
                                       Style="{StaticResource InfoValueStyle}"/>
                        </StackPanel>

                        <!-- Телефон -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Телефон" 
                                       Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Text="{Binding Phone}" 
                                       Style="{StaticResource InfoValueStyle}"/>
                        </StackPanel>

                        <!-- Возраст -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Возраст" 
                                       Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Text="{Binding AgeDisplay}" 
                                       Style="{StaticResource InfoValueStyle}"/>
                        </StackPanel>

                        <!-- Статистика -->
                        <Border Background="#F9FDF9" 
                                CornerRadius="8"
                                BorderBrush="#E8F5E8"
                                BorderThickness="1"
                                Padding="20"
                                Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Статистика" 
                                           FontSize="15" 
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           Margin="0,0,0,15"/>

                                <!-- Всего встреч -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Всего встреч" 
                                               FontSize="13" 
                                               Foreground="#666666"
                                               Width="100"/>
                                    <TextBlock Text="{Binding TotalBookings}" 
                                               FontSize="15" 
                                               FontWeight="SemiBold"
                                               Foreground="#4CAF50"/>
                                </StackPanel>

                                <!-- Завершенные -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Завершенные" 
                                               FontSize="13" 
                                               Foreground="#666666"
                                               Width="100"/>
                                    <TextBlock Text="{Binding CompletedBookings}" 
                                               FontSize="15" 
                                               FontWeight="SemiBold"
                                               Foreground="#2196F3"/>
                                </StackPanel>

                                <!-- Общий заработок -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Общий заработок" 
                                               FontSize="13" 
                                               Foreground="#666666"
                                               Width="100"/>
                                    <TextBlock Text="{Binding TotalEarnings, StringFormat={}{0:C}}" 
                                               FontSize="15" 
                                               FontWeight="SemiBold"
                                               Foreground="#9C27B0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Кнопки действий -->
            <Border Grid.Row="2" 
                    Background="White" 
                    CornerRadius="12"
                    Padding="25">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Редактировать профиль"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="25,12"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding EditProfileCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>