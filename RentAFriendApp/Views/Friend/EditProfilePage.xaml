<Page x:Class="RentAFriendApp.Views.Friend.EditProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RentAFriendApp.Views.Friend"
      xmlns:converters="clr-namespace:RentAFriendApp.Converters" 
      xmlns:base="clr-namespace:RentAFriendApp.ViewModels.Base"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Редактирование профиля"
      Background="#F8F9FA"
      Loaded="Page_Loaded">
    <Page.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1" />
    </Page.RenderTransform>
    <Page.Resources>
        <!-- Стили -->
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <DropShadowEffect x:Key="DropShadowEffect" 
                  BlurRadius="4" 
                  Opacity="0.2" 
                  ShadowDepth="2" 
                  RenderingBias="Quality"/>
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#4CAF50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#AAAAAA"
                                           FontStyle="Italic"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#F44336"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ValidationIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.2" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="3" Opacity="0.3" BlurRadius="6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Конвертеры -->
        <converters:ValidationToColorConverter x:Key="ValidationColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:PercentConverter x:Key="PercentConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <!-- Анимации -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1" Duration="0:0:1"
                             AutoReverse="True"/>
        </Storyboard>

    </Page.Resources>

    <Grid>
        <!-- Основной контент -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- Заголовок с аватаром -->
                <Border Background="White" 
                        CornerRadius="16"
                        Padding="30"
                        Margin="0,0,0,25"
                        Effect="{StaticResource DropShadowEffect}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Аватар -->
                        <Border Grid.Column="0" 
                                Width="100" 
                                Height="100" 
                                CornerRadius="50">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                    <GradientStop Color="#8BC34A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox>
                                <TextBlock Text="{Binding Initials}" 
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Margin="10"/>
                            </Viewbox>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Opacity="0.3" BlurRadius="10"/>
                            </Border.Effect>
                        </Border>

                        <!-- Информация -->
                        <StackPanel Grid.Column="1" 
                                    Margin="25,0,0,0" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="Редактирование профиля" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       Foreground="#333333"/>
                            <TextBlock Text="Обновите информацию о себе. Это поможет клиентам лучше вас узнать"
                                       FontSize="15"
                                       Foreground="#666666"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                            <!-- Статус и статистика -->
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <!-- Статус верификации -->
                                <Border Background="{Binding VerificationStatusColor}" 
                                        CornerRadius="8" 
                                        Padding="12,6"
                                        Margin="0,0,15,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VerificationIcon}" 
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding VerificationStatus}" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Счетчик изменений -->
                                <Border Background="#E3F2FD" 
                                        CornerRadius="8" 
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ChangesCountDisplay}" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#1976D2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Быстрые действия -->
                        <StackPanel Grid.Column="2" 
                                    VerticalAlignment="Center"
                                    Width="180">
                            <Button Content="🔄 Обновить"
                                    Background="#2196F3"
                                    Foreground="White"
                                    Height="40"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,10"
                                    Command="{Binding LoadDataCommand}"/>
                            <Button Content="↩ Сбросить"
                                    Background="#FF9800"
                                    Foreground="White"
                                    Height="40"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Command="{Binding ResetFormCommand}"
                                    IsEnabled="{Binding HasChanges}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Основная форма -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: Основная информация -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="16"
                            Padding="30"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="👤 Основная информация" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,25"/>

                            <!-- ФИО с валидацией -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="ФИО" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding FullNameValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding FullNameValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InputFieldStyle}"
                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Введите ваше ФИО"/>
                            </StackPanel>

                            <!-- Email с валидацией -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Email" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding EmailValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding EmailValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InputFieldStyle}"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="example@email.com"/>
                                <TextBlock Text="{Binding EmailValidationMessage}"
                                           FontSize="12"
                                           Foreground="{Binding IsEmailValid, Converter={StaticResource ValidationColorConverter}}"
                                           Margin="5,5,0,0"/>
                            </StackPanel>

                            <!-- Телефон -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Телефон" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding PhoneValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding PhoneValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InputFieldStyle}"
                                        Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        base:TextBoxBehavior.LostFocusCommand="{Binding LostFocusPhoneCommand}"
                                        Tag="+7 (999) 123-45-67"/>
                                <TextBlock Text="Используется для связи с клиентами"
                                           FontSize="12"
                                           Foreground="#999999"
                                           Margin="5,5,0,0"/>
                            </StackPanel>

                            <!-- Город с автодополнением -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Город" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding CityValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding CityValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InputFieldStyle}"
                                         Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Москва"/>

                                <!-- Подсказки городов -->
                                <ItemsControl ItemsSource="{Binding FilteredCities}" 
                                              Margin="0,5,0,0"
                                              MaxHeight="150"
                                              Visibility="{Binding FilteredCities.Count, 
                                              Converter={StaticResource CountToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F5F5F5" 
                                                    CornerRadius="6" 
                                                    Padding="10,8"
                                                    Margin="0,0,0,5"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                        Command="{Binding DataContext.SelectCityCommand, 
                                                                 RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding}" 
                                                           FontSize="13"
                                                           Foreground="#333333"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Возраст -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Возраст" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding AgeValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding AgeValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource InputFieldStyle}"
                                             Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             Tag="18"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AgeDisplay}" 
                                               Foreground="#666666"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Правая колонка: Профессиональная информация -->
                    <Border Grid.Column="2" 
                            Background="White" 
                            CornerRadius="16"
                            Padding="30"
                            Effect="{StaticResource DropShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="💼 Профессиональная информация" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,25"/>

                            <!-- Почасовая ставка -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Почасовая ставка" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding HourlyRateValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding HourlyRateValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource InputFieldStyle}"
                                             Text="{Binding HourlyRateText, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="500"/>
                                    <StackPanel Grid.Column="1" 
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="₽"
                                                   Foreground="#666666"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="/час" 
                                                   Foreground="#999999"
                                                   FontSize="14"
                                                   Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Рекомендуемая ставка: 500-2000 ₽/час"
                                           FontSize="12"
                                           Foreground="#999999"
                                           Margin="5,5,0,0"/>
                            </StackPanel>

                            <!-- Описание с прогресс-баром -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Описание (о себе)" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding BioValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding BioValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource InputFieldStyle}"
                                         Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Расскажите о себе, своих увлечениях и опыте..."
                                         Height="140"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"/>

                                <!-- Прогресс-бар и счетчик -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Прогресс-бар -->
                                    <Border Grid.Column="0"
                                            Height="4"
                                            Background="#E0E0E0"
                                            CornerRadius="2"
                                            VerticalAlignment="Center">
                                        <Border Width="{Binding BioProgressPercent, Converter={StaticResource PercentConverter}}"
                                                Background="{Binding BioProgressColor}"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"/>
                                    </Border>

                                    <!-- Счетчик -->
                                    <StackPanel Grid.Column="1" 
                                                Orientation="Horizontal"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="{Binding BioLength}"
                                                   Foreground="{Binding BioProgressColor}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="/2000"
                                                   Foreground="#999999"
                                                   FontSize="12"
                                                   Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Хобби и интересы -->
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🎯 Хобби и интересы" 
                                               Style="{StaticResource InputLabelStyle}"/>
                                    <TextBlock Text="{Binding HobbiesValidation}"
                                               Style="{StaticResource ValidationIconStyle}"
                                               Foreground="{Binding HobbiesValidation, 
                                                        Converter={StaticResource ValidationColorConverter}}"/>
                                </StackPanel>

                                <!-- Поле для добавления хобби -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource InputFieldStyle}"
                                             Text="{Binding NewHobby, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Например: чтение, спорт, музыка..."
                                             Margin="0,0,10,0"/>
                                    <Button Grid.Column="1"
                                            Content="➕ Добавить"
                                            Width="100"
                                            Height="45"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding AddHobbyCommand}"
                                            IsEnabled="{Binding CanAddHobby}"/>
                                </Grid>

                                <!-- Список хобби -->
                                <Border Background="#FAFAFA"
                                        CornerRadius="10"
                                        Padding="15"
                                        MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding HobbiesList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#E8F5E8" 
                                                            CornerRadius="8" 
                                                            Padding="10,6"
                                                            Margin="0,0,10,10"
                                                            BorderThickness="1"
                                                            BorderBrush="#C8E6C9">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding}" 
                                                                       FontSize="13"
                                                                       Foreground="#2E7D32"
                                                                       FontWeight="Bold"/>
                                                            <Button Content="✕"
                                                                    Width="22"
                                                                    Height="22"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="#666666"
                                                                    FontSize="11"
                                                                    Cursor="Hand"
                                                                    Margin="8,0,0,0"
                                                                    Padding="0"
                                                                    ToolTip="Удалить хобби"
                                                                    Command="{Binding DataContext.RemoveHobbyCommand, 
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="Transparent"
                                                                                            CornerRadius="11">
                                                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                                                          VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#FFCDD2"/>
                                                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="Добавьте хобби, чтобы клиенты могли найти вас по интересам"
                                           FontSize="12"
                                           Foreground="#999999"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Кнопки действий -->
                <Border Background="White" 
                        CornerRadius="16"
                        Padding="30"
                        Margin="0,25,0,0"
                        Effect="{StaticResource DropShadowEffect}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Сообщение об ошибке -->
                        <Border Grid.Column="0"
                                x:Name="ErrorBorder"
                                Background="#FFF5F5"
                                BorderBrush="#FFCDD2"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F44336" 
                                        Width="40" 
                                        Height="40"
                                        CornerRadius="20"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="!"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Ошибка сохранения" 
                                               Foreground="#D32F2F"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ErrorMessage}" 
                                               Foreground="#D32F2F"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               MaxWidth="500"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Индикатор валидации -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsFormValid, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Background="#FFF3E0" 
                                    CornerRadius="8" 
                                    Padding="12,8"
                                    BorderThickness="1"
                                    BorderBrush="#FFB74D">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠"
                                               FontSize="16"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Заполните все обязательные поля корректно"
                                               Foreground="#FF9800"
                                               FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Кнопка отмены -->
                        <Button Grid.Column="1"
                                Content="Отменить"
                                Width="130"
                                Height="48"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Foreground="#666666"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="0,0,15,0"
                                Cursor="Hand"
                                Command="{Binding CancelCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Кнопка сохранения -->
                        <Button Grid.Column="2"
                                Content="{Binding SaveButtonText}"
                                Style="{StaticResource SaveButtonStyle}"
                                Width="220"
                                Command="{Binding SaveProfileCommand}">
                            
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>

                <!-- Подсказка -->
                <Border Background="#E3F2FD" 
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡"
                                   FontSize="20"
                                   Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Советы по заполнению профиля" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• Добавьте качественное описание о себе
                                        • Укажите реальные хобби и интересы
                                        • Установите конкурентную почасовую ставку
                                        • Подтвердите email для повышения доверия"
                                       FontSize="13"
                                       Foreground="#1976D2"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>