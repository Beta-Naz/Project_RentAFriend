<Page x:Class="RentAFriendApp.Views.Friend.FriendHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RentAFriendApp.Views.Friend"
      xmlns:converters="clr-namespace:RentAFriendApp.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Панель управления"
      Background="#F8F9FA"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- Конвертеры -->
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:StatusToTextConverter x:Key="StatusToTextConverter"/>
        <converters:DateToDayOfWeekConverter x:Key="DateToDayOfWeekConverter"/>

        <!-- Статистические карточки -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок быстрых действий -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" Opacity="0.1" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                <Rectangle x:Name="RippleEffect" Fill="#20000000" 
                                           Opacity="0" RadiusX="10" RadiusY="10"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FDF9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="RippleEffect" Property="Opacity" Value="0.1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F5E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для элементов списка -->
        <Style x:Key="MeetingItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" Opacity="0.05" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7F0"/>
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Иконки -->
        <PathGeometry x:Key="BookingIcon">M9,2C7.9,2 7,2.9 7,4V4.29C5.34,5.17 4,6.95 4,9V17C4,19.21 5.79,21 8,21H16C18.21,21 20,19.21 20,17V9C20,6.95 18.66,5.17 17,4.29V4C17,2.9 16.1,2 15,2H9M9,4H15V4.29C14.53,4.11 14.03,4 13.5,4H10.5C9.97,4 9.47,4.11 9,4.29V4M9,7V8H15V7H9M12,17.5C10.07,17.5 8.5,15.93 8.5,14C8.5,12.07 10.07,10.5 12,10.5C13.93,10.5 15.5,12.07 15.5,14C15.5,15.93 13.93,17.5 12,17.5Z</PathGeometry>
        <PathGeometry x:Key="CalendarIcon">M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z</PathGeometry>
        <PathGeometry x:Key="ProfileIcon">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</PathGeometry>
        <PathGeometry x:Key="StarIcon">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</PathGeometry>
        <PathGeometry x:Key="MoneyIcon">M11.8,10.9C9.53,10.31 8.8,9.7 8.8,8.75C8.8,7.66 9.81,6.9 11.5,6.9C13.28,6.9 14.26,7.75 14.3,8.9H16.21C16.14,7.08 14.94,5.5 12.5,5.2V3H10.5V5.16C8.06,5.5 6.85,7.08 6.79,8.9H8.7C8.75,7.75 9.72,6.9 11.5,6.9C13.25,6.9 14.2,7.65 14.2,8.75C14.2,9.99 13.41,10.5 11.8,10.9V10.9M10.5,13V21H12.5V13H10.5Z</PathGeometry>
        <PathGeometry x:Key="ClockIcon">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</PathGeometry>
        <PathGeometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</PathGeometry>
        <PathGeometry x:Key="EmptyIcon">M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M12,20C7.58,20 4,16.42 4,12C4,7.58 7.58,4 12,4C16.42,4 20,7.58 20,12C20,16.42 16.42,20 12,20M16,17L12,13L8,17H16Z</PathGeometry>
    </Page.Resources>

    <Grid>
        <!-- Индикатор загрузки -->
        <Border Background="#80000000" 
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="1000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="30"
                        Width="200"
                        Height="200">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" 
                                     Height="4" 
                                     Margin="0,0,0,20"/>
                        <TextBlock Text="Загрузка данных..." 
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок с приветствием -->
                <Border Grid.Row="0" 
                        Background="White" 
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,25"
                        Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Аватар -->
                        <Border Grid.Column="0" 
                                Width="60" 
                                Height="60" 
                                CornerRadius="30"
                                Background="#4CAF50"
                                Margin="0,0,20,0">
                            <TextBlock Text="{Binding CurrentUserInitials}" 
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Приветствие -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding WelcomeMessage}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#333333"/>
                            <TextBlock Text="{Binding CurrentDate}" 
                                       FontSize="14"
                                       Foreground="#666666"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Уведомления об ошибках -->
                        <Border Grid.Column="2" 
                                Background="#FFF5F5" 
                                CornerRadius="8"
                                Padding="15"
                                BorderBrush="#FFCDD2"
                                BorderThickness="1"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z" 
                                      Fill="#F44336"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ErrorMessage}" 
                                           FontSize="13"
                                           Foreground="#D32F2F"
                                           TextWrapping="Wrap"
                                           MaxWidth="300"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Статистика -->
                <Border Grid.Row="1" 
                        Background="White" 
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,25"
                        Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Общее количество бронирований -->
                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <TextBlock Text="{Binding TotalBookings}" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#4CAF50"/>
                            <TextBlock Text="Всего бронирований" 
                                       FontSize="13" 
                                       Foreground="#666666"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#E0E0E0" Margin="0,0,30,0"/>

                        <!-- Ожидающие подтверждения -->
                        <StackPanel Grid.Column="2" Margin="0,0,30,0">
                            <TextBlock Text="{Binding PendingRequests}" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#FF9800"/>
                            <TextBlock Text="Ожидают подтверждения" 
                                       FontSize="13" 
                                       Foreground="#666666"/>
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Background="#E0E0E0" Margin="0,0,30,0"/>

                        <!-- Общий заработок -->
                        <StackPanel Grid.Column="4" Margin="0,0,30,0">
                            <TextBlock Text="{Binding TotalEarnings, StringFormat={}{0:C}}" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#2196F3"/>
                            <TextBlock Text="Общий заработок" 
                                       FontSize="13" 
                                       Foreground="#666666"/>
                        </StackPanel>

                        <Border Grid.Column="5" Width="1" Background="#E0E0E0" Margin="0,0,30,0"/>

                        <!-- Средний рейтинг -->
                        <StackPanel Grid.Column="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="#9C27B0"/>
                                <TextBlock Text="/5" 
                                           FontSize="16" 
                                           Foreground="#666666"
                                           VerticalAlignment="Bottom"
                                           Margin="5,0,0,5"/>
                            </StackPanel>
                            <TextBlock Text="Средний рейтинг" 
                                       FontSize="13" 
                                       Foreground="#666666"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Основной контент -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: Ближайшие встречи и быстрые действия -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <!-- Ближайшие встречи -->
                        <Border Background="White" 
                                CornerRadius="12" 
                                Padding="0" 
                                Margin="0,0,0,15"
                                Style="{StaticResource StatCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->
                                <Border Grid.Row="0" 
                                        Background="#F9FDF9" 
                                        CornerRadius="12,12,0,0"
                                        BorderBrush="#E8F5E8"
                                        BorderThickness="0,0,0,1"
                                        Padding="20">
                                    <StackPanel Height="30" Orientation="Horizontal">
                                        <Path VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Data="{StaticResource ClockIcon}" 
                                              Fill="#4CAF50" 
                                              Width="24" 
                                              Height="23"
                                              Margin="0,0,10,0"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Ближайшие встречи" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>
                                        <TextBlock Text="{Binding UpcomingMeetings.Count, StringFormat={}({0})}" 
                                                   FontSize="14"
                                                   Foreground="#666666"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Список встреч или сообщение об отсутствии -->
                                <Grid Grid.Row="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                                  MaxHeight="300"
                                                  Visibility="{Binding HasUpcomingMeetings, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding UpcomingMeetings}" 
                                                      Margin="20"
                                                      BorderThickness="0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MeetingItemStyle}"
                                                            PreviewMouseLeftButtonUp="MeetingItem_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Дата и время -->
                                                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                                <TextBlock Text="{Binding ScheduleDate, StringFormat={}dd.MM}"
                                                                           FontSize="20"
                                                                           FontWeight="Bold"
                                                                           Foreground="#4CAF50"/>
                                                                <TextBlock  Text="{Binding ScheduleDate, Converter={StaticResource DateToDayOfWeekConverter}}"
                                                                           FontSize="12"
                                                                           Foreground="#666666"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Информация о встрече -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding ClientName}" 
                                                                           FontSize="14" 
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#333333"/>
                                                                <TextBlock Text="{Binding TimeRangeDisplay}" 
                                                                           FontSize="13" 
                                                                           Foreground="#666666"
                                                                           Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Purpose}" 
                                                                           FontSize="12" 
                                                                           Foreground="#888888"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0"
                                                                           MaxHeight="40"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Статус и сумма -->
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                <Border Background="{Binding Status, Converter={StaticResource StatusToColor}}" 
                                                                        CornerRadius="4" 
                                                                        Padding="6,3"
                                                                        HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" 
                                                                               FontSize="11" 
                                                                               Foreground="White"
                                                                               FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C}}" 
                                                                           FontSize="16" 
                                                                           FontWeight="Bold"
                                                                           Foreground="#333333"
                                                                           Margin="0,8,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Сообщение об отсутствии встреч -->
                                    <Border Visibility="{Binding HasUpcomingMeetings, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                                            Margin="20">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Viewbox Width="64" Height="64" Margin="0,0,0,20">
                                                <Path Data="{StaticResource EmptyIcon}" 
                                                      Fill="#E0E0E0"/>
                                            </Viewbox>
                                            <TextBlock Text="Нет предстоящих встреч" 
                                                       FontSize="14"
                                                       Foreground="#666666"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Все встречи отображаются здесь" 
                                                       FontSize="12"
                                                       Foreground="#999999"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Быстрые действия -->
                        <Border Background="White" 
                                CornerRadius="12" 
                                Padding="20"
                                Style="{StaticResource StatCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Быстрые действия" 
                                           FontSize="16" 
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           Margin="0,0,0,15"/>

                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <!-- Редактировать профиль -->
                                    <Button Style="{StaticResource QuickActionButtonStyle}"
                                            Command="{Binding EditProfileCommand}"
                                            Width="180" 
                                            Height="100" 
                                            Margin="0,0,15,15">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <Viewbox Width="32" Height="32" Margin="0,0,0,8">
                                                <Path Data="{StaticResource ProfileIcon}" 
                                                      Fill="#4CAF50"/>
                                            </Viewbox>
                                            <TextBlock Text="Редактировать профиль" 
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontSize="13"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Управление расписанием -->
                                    <Button Style="{StaticResource QuickActionButtonStyle}"
                                            Command="{Binding ManageScheduleCommand}"
                                            Width="180" 
                                            Height="100" 
                                            Margin="0,0,15,15">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <Viewbox Width="32" Height="32" Margin="0,0,0,8">
                                                <Path Data="{StaticResource CalendarIcon}" 
                                                      Fill="#2196F3"/>
                                            </Viewbox>
                                            <TextBlock Text="Управление расписанием" 
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontSize="13"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Запросы на бронирование -->
                                    <Button Style="{StaticResource QuickActionButtonStyle}"
                                            Command="{Binding ViewBookingRequestsCommand}"
                                            Width="180" 
                                            Height="100" 
                                            Margin="0,0,15,15">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <Viewbox Width="32" Height="32" Margin="0,0,0,8">
                                                <Path Data="{StaticResource BookingIcon}" 
                                                      Fill="#FF9800"/>
                                            </Viewbox>
                                            <TextBlock Text="Запросы на бронирование" 
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Правая колонка: Последние отзывы -->
                    <Border Grid.Column="1" 
                            Background="White" 
                            CornerRadius="12"
                            Padding="0"
                            Margin="10,0,0,0"
                            Style="{StaticResource StatCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовок -->
                            <Border Grid.Row="0" 
                                    Background="#F9FDF9" 
                                    CornerRadius="12,12,0,0"
                                    BorderBrush="#E8F5E8"
                                    BorderThickness="0,0,0,1"
                                    Padding="20">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource StarIcon}" 
                                          Fill="#FFC107" 
                                          Width="20" 
                                          Height="20"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="Последние отзывы" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="#333333"/>
                                    <TextBlock Text="{Binding RecentReviews.Count, StringFormat={}({0})}" 
                                               FontSize="14"
                                               Foreground="#666666"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Список отзывов или сообщение об отсутствии -->
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              MaxHeight="400"
                                              Visibility="{Binding HasRecentReviews, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding RecentReviews}" 
                                                  Margin="20"
                                                  BorderThickness="0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource MeetingItemStyle}"
                                                        PreviewMouseLeftButtonUp="ReviewItem_Click">
                                                    <StackPanel>
                                                        <!-- Рейтинг и имя -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Rating, StringFormat='★{0}'}" 
                                                                       FontSize="14"
                                                                       Foreground="#FFC107"/>
                                                            <TextBlock Text="{Binding ClientName}" 
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#333333"
                                                                       Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" 
                                                                       FontSize="11"
                                                                       Foreground="#888888"
                                                                       HorizontalAlignment="Right"
                                                                       Margin="10,0,0,0"/>
                                                        </StackPanel>

                                                        <!-- Комментарий -->
                                                        <TextBlock Text="{Binding Comment}" 
                                                                   FontSize="12" 
                                                                   Foreground="#666666"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="60"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Сообщение об отсутствии отзывов -->
                                <Border Visibility="{Binding HasRecentReviews, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                                        Margin="20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Viewbox Width="64" Height="64" Margin="0,0,0,20">
                                            <Path Data="{StaticResource EmptyIcon}" 
                                                  Fill="#E0E0E0"/>
                                        </Viewbox>
                                        <TextBlock Text="Нет отзывов" 
                                                   FontSize="14"
                                                   Foreground="#666666"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Отзывы появятся здесь" 
                                                   FontSize="12"
                                                   Foreground="#999999"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Индикатор рейтинга -->
                            <Border Grid.Row="2" 
                                    Background="#FFF9E6" 
                                    CornerRadius="0,0,12,12"
                                    BorderBrush="#FFE082"
                                    BorderThickness="0,1,0,0"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Ваш общий рейтинг" 
                                               FontSize="13" 
                                               Foreground="#666666"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}" 
                                                   FontSize="24" 
                                                   FontWeight="Bold"
                                                   Foreground="#FF9800"/>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding AverageRatingStars}" 
                                                       FontSize="14"
                                                       Foreground="#FFC107"/>
                                            <TextBlock Text="{Binding RatingDescription}" 
                                                       FontSize="11"
                                                       Foreground="#666666"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Кнопка обновления -->
                <Border Grid.Row="3" 
                        Background="White" 
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,15,0,0"
                        Style="{StaticResource StatCardStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Обновить данные" 
                                Background="#4CAF50"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="20,10"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding RefreshCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Viewbox Width="16" Height="16" 
                                                                 Margin="0,0,8,0">
                                                            <Path Data="{StaticResource RefreshIcon}" 
                                                                  Fill="White"/>
                                                        </Viewbox>
                                                        <ContentPresenter Grid.Column="1" 
                                                                          HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#45a049"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3d8b40"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="#A5D6A7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>