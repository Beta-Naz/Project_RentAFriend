<Page x:Class="RentAFriendApp.Views.Friend.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RentAFriendApp.Views.Friend"
      xmlns:localItems="clr-namespace:RentAFriendApp.Views.Friend.Controls"
      xmlns:converters="clr-namespace:RentAFriendApp.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Расписание"
      Background="#F8F9FA"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- Конвертеры -->
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <!-- Стили -->

        <DropShadowEffect x:Key="DropShadowEffect" 
                  BlurRadius="4" 
                  Opacity="0.2" 
                  ShadowDepth="2" 
                  RenderingBias="Quality"/>
        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="33.1"/>
            <Setter Property="Width" Value="33.1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                <Border x:Name="dotIndicator" 
                                        Width="4" 
                                        Height="4" 
                                        CornerRadius="2" 
                                        Background="#4CAF50"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,4"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FDF9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasSlots}" Value="True">
                                <Setter TargetName="dotIndicator" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodayButtonStyle" TargetType="Button" BasedOn="{StaticResource DayButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SelectedDayButtonStyle" TargetType="Button" BasedOn="{StaticResource DayButtonStyle}">
            <Setter Property="Background" Value="#E8F5E8"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TimeSlotStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9FDF9"/>
            <Setter Property="BorderBrush" Value="#E8F5E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BookedSlotStyle" TargetType="Border" BasedOn="{StaticResource TimeSlotStyle}">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#FFCDD2"/>
        </Style>

        <Style x:Key="AvailableSlotStyle" TargetType="Border" BasedOn="{StaticResource TimeSlotStyle}">
            <Setter Property="Background" Value="#F0F9F0"/>
            <Setter Property="BorderBrush" Value="#C8E6C9"/>
        </Style>

        <Style x:Key="UnavailableSlotStyle" TargetType="Border" BasedOn="{StaticResource TimeSlotStyle}">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Анимация появления -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Стиль для кнопки генерации недели -->
        <Style x:Key="GenerateWeekButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="calendarIcon" 
                                      Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M16.5,16.5h-9v-9h9V16.5z" 
                                      Fill="#4CAF50" 
                                      Stretch="Uniform" 
                                      Width="16" 
                                      Height="16" 
                                      Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FDF9"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F5E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <!-- Progress Overlay -->
        <Border x:Name="LoadingOverlay" 
                Background="#80000000" 
                Visibility="Collapsed"
                Panel.ZIndex="1000">
            <Grid>
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="30"
                        Width="200"
                        Height="200">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" 
                                     Height="6" 
                                     Width="150"
                                     Foreground="#4CAF50"
                                     Margin="0,0,0,20"/>
                        <TextBlock Text="Загрузка..." 
                                   FontSize="14" 
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Error Message -->
        <Border x:Name="ErrorContainer" 
                Background="#FFF5F5" 
                BorderBrush="#FFCDD2" 
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="900">
            <StackPanel Orientation="Horizontal">
                <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-2h2V17z M13,13h-2V7h2V13z" 
                      Fill="#D32F2F" 
                      Stretch="Uniform" 
                      Width="20" 
                      Height="20"
                      Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorMessage}" 
                           FontSize="13" 
                           Foreground="#D32F2F"
                           TextWrapping="Wrap"
                           Width="300"/>
                <Button Content="✕" 
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="#D32F2F"
                        FontSize="16"
                        Cursor="Hand"
                        Click="DismissError_Click"
                        Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель управления -->
                <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="12"
                Padding="25"
                Margin="0,0,0,20"
                Effect="{StaticResource DropShadowEffect}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Навигация по дням -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="PrevDayBtn"
                            Content="◀"
                            Width="40"
                            Height="40"
                            Style="{StaticResource DayButtonStyle}"
                            Command="{Binding PreviousDayCommand}"
                            ToolTip="Предыдущий день"
                            Margin="0,0,10,0">
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Button.Click">
                                        <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>

                            <Border Background="#F9FDF9" 
                            CornerRadius="8"
                            BorderBrush="#E8F5E8"
                            BorderThickness="1"
                            Padding="20,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding DateDisplay}" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       Foreground="#333333"/>
                                    <TextBlock Text="{Binding SelectedDate, StringFormat='dd MMMM yyyy'}" 
                                       FontSize="14"
                                       Foreground="#666666"
                                       Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="NextDayBtn"
                            Content="▶"
                            Width="40"
                            Height="40"
                            Style="{StaticResource DayButtonStyle}"
                            Command="{Binding NextDayCommand}"
                            ToolTip="Следующий день"
                            Margin="10,0,0,0">
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Button.Click">
                                        <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                        </StackPanel>

                        <!-- Быстрые действия -->
                        <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                            <Border Background="#4CAF50" Margin="0,0,10,0" CornerRadius="12" VerticalAlignment="Center">
                                <Button x:Name="TodayBtn"
                            Content="Сегодня"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="20,12"
                           
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding TodayCommand}"
                            ToolTip="Перейти к сегодняшнему дню"
                            >
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="Button.Click">
                                            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Border>
                            <Border CornerRadius="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button x:Name="GenerateWeekBtn"
                                    Content="На неделю"
                                    Height="40"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource GenerateWeekButtonStyle}"
                                    Command="{Binding GenerateWeekScheduleCommand}"
                                    ToolTip="Сгенерировать стандартное расписание на неделю"/>
                            </Border>
                            <Border Background="White" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="15,10">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                        <TextBlock Text="Начало:" 
                                           Foreground="#666666"
                                           Margin="0,0,5,0"/>
                                        <TextBox x:Name="StartTimeBox"
                                         Text="{Binding NewStartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#333333"
                                         FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Конец:" 
                                           Foreground="#666666"
                                           Margin="0,0,5,0"/>
                                        <TextBox x:Name="EndTimeBox"
                                         Text="{Binding NewEndTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#333333"
                                         FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Статистика -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Всего слотов -->
                            <StackPanel Orientation="Vertical" Margin="0,0,15,0" Width="70">
                                <TextBlock Text="Всего:" FontSize="12" Foreground="#999999"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalSlots}" 
                                           HorizontalAlignment="Center"
                                           FontSize="18" 
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- Доступные слоты -->
                            <StackPanel Orientation="Vertical" Margin="0,0,15,0" Width="80">
                                <TextBlock Text="Свободно:" 
                                           FontSize="12" 
                                           Foreground="#66BB6A"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AvailableSlots}" 
                                           FontSize="18" 
                                           HorizontalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#4CAF50"
                                           Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- Забронированные слоты -->
                            <StackPanel Orientation="Vertical" Width="70">
                                <TextBlock Text="Занято:" 
                                           HorizontalAlignment="Center"
                                           FontSize="12" 
                                           Foreground="#FFA726"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BookedSlots}" 
                                           HorizontalAlignment="Center"
                                           FontSize="18" 
                                           FontWeight="Bold"
                                           Foreground="#FF9800"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- Основной контент -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Календарь -->
                <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="12"
                    Padding="20"
                    Effect="{StaticResource DropShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Календарь" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,0,0,20"/>

                        <!-- Месяц и год -->
                        <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,15">
                            <Button Content="‹" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Foreground="#666666"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="PreviousMonth_Click"
                                ToolTip="Предыдущий месяц"/>
                            <TextBlock Text="{Binding CurrentMonthYear}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="15,0"/>
                            <Button Content="›" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Foreground="#666666"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="NextMonth_Click"
                                ToolTip="Следующий месяц"/>
                        </StackPanel>

                        <!-- Дни недели -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Пн" Foreground="#666666" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Вт" Foreground="#666666" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ср" Foreground="#666666" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Чт" Foreground="#666666" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Пт" Foreground="#666666" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Сб" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Вс" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Дни месяца -->
                        <ItemsControl x:Name="CalendarDaysControl"
                                  ItemsSource="{Binding CalendarDays}"
                                  Margin="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Day}"
                                        Style="{StaticResource DayButtonStyle}"
                                        Command="{Binding DataContext.SelectDateCommand, 
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding Date}"
                                        ToolTip="{Binding Date, StringFormat='dd MMMM yyyy'}"
                                        Margin="2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Легенда -->
                        <Border Background="#F9F9F9" 
                            CornerRadius="6" 
                            Padding="15"
                            Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Легенда:" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="12" 
                                        Height="12" 
                                        Background="#4CAF50" 
                                        CornerRadius="2"
                                        Margin="0,0,8,0"/>
                                    <TextBlock Text="Сегодня" 
                                           FontSize="11" 
                                           Foreground="#666666"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="12" 
                                        Height="12" 
                                        Background="#E8F5E8" 
                                        CornerRadius="2"
                                        Margin="0,0,8,0"/>
                                    <TextBlock Text="Выбрано" 
                                           FontSize="11" 
                                           Foreground="#666666"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" 
                                        Height="12" 
                                        Background="Transparent" 
                                        BorderBrush="#4CAF50" 
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,8,0">
                                        <Ellipse Width="4" 
                                             Height="4" 
                                             Fill="#4CAF50" 
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,2"/>
                                    </Border>
                                    <TextBlock Text="Есть слоты" 
                                           FontSize="11" 
                                           Foreground="#666666"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Расписание на день -->
                <Border Grid.Column="2" 
                    Background="White" 
                    CornerRadius="12"
                    Padding="25"
                    Effect="{StaticResource DropShadowEffect}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <Border Grid.Row="0" 
                            Background="#F9FDF9" 
                            CornerRadius="8"
                            BorderBrush="#E8F5E8"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Расписание на день" 
                                           FontSize="20" 
                                           FontWeight="Bold"
                                           Foreground="#333333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Path Data="M19,3h-1V1h-2v2H8V1H6v2H5c-1.11,0-2,0.9-2,2v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V5c0-1.1-0.9-2-2-2z M19,19H5V8h14V19z" 
                                          Fill="#4CAF50" 
                                          Stretch="Uniform" 
                                          Width="16" 
                                          Height="16"
                                          Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DateDisplay}" 
                                               FontSize="14"
                                               Foreground="#666666"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Кнопка добавления -->
                                <Button Grid.Column="1"
                                    Content="Добавить слот"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="20,12"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding AddTimeSlotCommand}"
                                    IsEnabled="{Binding CanAddTimeSlot}"
                                    ToolTip="Добавить новый временной слот">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanAddTimeSlot}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Слоты времени или пустое состояние -->
                        <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,5,0">
                            <Grid>
                                <!-- Пустое состояние -->
                                <Border Visibility="{Binding HasScheduleSlots, Converter={StaticResource InverseBoolToVisibility}}"
                                    Background="#F9F9F9"
                                    CornerRadius="8"
                                    Padding="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="M19,3h-1V1h-2v2H8V1H6v2H5c-1.11,0-2,0.9-2,2v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V5c0-1.1-0.9-2-2-2z M19,19H5V8h14V19z M9,10h6v2H9V10z M9,14h6v2H9V14z" 
                                          Fill="#CCCCCC" 
                                          Stretch="Uniform" 
                                          Width="64" 
                                          Height="64"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,20"/>
                                        <TextBlock Text="Расписание пусто" 
                                               FontSize="18" 
                                               FontWeight="SemiBold"
                                               Foreground="#999999"
                                               HorizontalAlignment="Center"/>
                                        <TextBlock Text="Добавьте временные слоты для этой даты" 
                                               FontSize="14"
                                               Foreground="#999999"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Слоты времени -->
                                <ItemsControl x:Name="ScheduleSlotsControl"
                                    ItemsSource="{Binding ScheduleSlots}"
                                    Visibility="{Binding HasScheduleSlots, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <localItems:TimeSlotItem />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <!-- Подсказка внизу -->
                        <Border Grid.Row="2"
                            Background="#F9F9F9"
                            CornerRadius="6"
                            Padding="15"
