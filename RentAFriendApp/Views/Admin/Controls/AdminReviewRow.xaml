<UserControl x:Class="RentAFriendApp.Views.Admin.Controls.AdminReviewRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding ReviewID, StringFormat='#{0}'}" FontSize="12" Foreground="#757575" VerticalAlignment="Top" Margin="0,4,0,0"/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#212121" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="10,0,0,0" FontSize="13">
                        <Run Text="⭐ " Foreground="#FFC107"/>
                        <Run Text="{Binding Rating, StringFormat={}{0}/5}" Foreground="#212121" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding Comment}" FontSize="12" Foreground="#616161" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" Foreground="#9E9E9E">
                        <Run Text="Автор: "/>
                        <Run Text="{Binding ClientName}" FontWeight="SemiBold" Foreground="#424242"/>
                    </TextBlock>
                    <TextBlock Text=" · " FontSize="11" Foreground="#BDBDBD"/>
                    <TextBlock FontSize="11" Foreground="#9E9E9E">
                        <Run Text="Бронирование №"/>
                        <Run Text="{Binding BookingID}"/>
                    </TextBlock>
                    <TextBlock Text=" · " FontSize="11" Foreground="#BDBDBD"/>
                    <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="11" Foreground="#9E9E9E"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0" Width="100">
                <Button Content="✅ Одобрить" Background="#4CAF50" Foreground="White" FontSize="12" FontWeight="SemiBold"
                        Height="34" Width="100" BorderThickness="0" Cursor="Hand" Margin="0,0,0,6"
                        Click="Approve_Click"/>
                <Button Content="❌ Отклонить" Background="#F44336" Foreground="White" FontSize="12" FontWeight="SemiBold"
                        Height="34" Width="100" BorderThickness="0" Cursor="Hand"
                        Click="Reject_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>