<UserControl x:Class="RentAFriendApp.Views.Admin.Controls.AdminFriendRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:convertes="clr-namespace:RentAFriendApp.Converters.Admin">

    <UserControl.Resources>
        <convertes:InitialsConverter x:Key="InitialsConverter"/>
        <convertes:TrimTextConverter x:Key="TrimTextConverter"/>
        <convertes:MoneyFormatConverter x:Key="MoneyFormatConverter"/>
        <convertes:VerificationStatusConverter x:Key="VerificationStatusConverter"/>
        <convertes:VerificationColorConverter x:Key="VerificationColorConverter"/>
        <convertes:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding ProfileID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="18" Background="#4CAF50">
                    <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                               Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="#212121"/>
                    <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#757575"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding Bio, Converter={StaticResource TrimTextConverter}, ConverterParameter=60}"
                       FontSize="12" Foreground="#616161" VerticalAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Column="3" Text="{Binding City}" FontSize="12" Foreground="#424242" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="#4CAF50" VerticalAlignment="Center"
                       Text="{Binding HourlyRate, Converter={StaticResource MoneyFormatConverter}}"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⭐ " Foreground="#FFC107" FontSize="13"/>
                <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}" FontSize="12" Foreground="#212121"/>
            </StackPanel>

            <Border Grid.Column="6" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                    Background="{Binding IsVerified, Converter={StaticResource VerificationColorConverter}}">
                <TextBlock Text="{Binding IsVerified, Converter={StaticResource VerificationStatusConverter}}"
                           FontSize="10" Foreground="White" FontWeight="SemiBold"/>
            </Border>

            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✅" ToolTip="Верифицировать"
                        Background="#4CAF50" Foreground="White" FontSize="12" FontWeight="SemiBold"
                        Height="34" Width="34" Padding="0" BorderThickness="0" Cursor="Hand"
                        Click="Verify_Click"
                        Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                <Button Content="❌" ToolTip="Отклонить"
                        Background="#F44336" Foreground="White" FontSize="12" FontWeight="SemiBold"
                        Height="34" Width="34" Padding="0" BorderThickness="0" Cursor="Hand"
                        Click="Reject_Click" Margin="4,0"
                        Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>