<UserControl x:Class="RentAFriendApp.Views.Admin.Controls.AdminUserRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:convertes="clr-namespace:RentAFriendApp.Converters.Admin">

    <UserControl.Resources>
        <convertes:InitialsConverter x:Key="InitialsConverter"/>
        <convertes:RoleToColorConverter x:Key="RoleToColorConverter"/>
        <convertes:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <convertes:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <convertes:BooleanToStatusTextConverter x:Key="BoolToStatusConverter"/>
        <convertes:DateFormatConverter x:Key="DateFormatConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBlock HorizontalAlignment="Center" Text="{Binding UserID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>

            <StackPanel HorizontalAlignment="Left" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{Binding Role, Converter={StaticResource RoleToColorConverter}}">
                    <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                               Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="#212121"/>
                    <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#757575"/>
                </StackPanel>
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Grid.Column="2" Text="{Binding Email}" FontSize="12" 
                       Foreground="#424242" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <Border Grid.Column="3" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center"
                    Background="{Binding Role, Converter={StaticResource RoleToColorConverter}}">
                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
            </Border>

            <Border Grid.Column="4" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center"
                    Background="{Binding IsActive, Converter={StaticResource StatusToColorConverter}}">
                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                           FontSize="11" Foreground="White" FontWeight="SemiBold"/>
            </Border>

            <TextBlock HorizontalAlignment="Center" Grid.Column="5" FontSize="11" Foreground="#757575" VerticalAlignment="Center"
                       Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🚫" ToolTip="Заблокировать"
                        Width="34" Height="34" Background="Transparent" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Foreground="#F44336"
                        Click="Block_Click"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}"/>
                <Button Content="✅" ToolTip="Разблокировать"
                        Width="34" Height="34" Background="Transparent" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Foreground="#4CAF50"
                        Click="Unblock_Click"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                <Button Content="🗑" ToolTip="Удалить"
                        Width="34" Height="34" Background="Transparent" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Foreground="#9E9E9E"
                        Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>