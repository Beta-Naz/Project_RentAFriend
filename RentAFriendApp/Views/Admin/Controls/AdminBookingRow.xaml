<UserControl x:Class="RentAFriendApp.Views.Admin.Controls.AdminBookingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:convertes="clr-namespace:RentAFriendApp.Converters.Admin">

    <UserControl.Resources>
        <convertes:DateFormatConverter x:Key="DateFormatConverter"/>
        <convertes:MoneyFormatConverter x:Key="MoneyFormatConverter"/>
        <convertes:BookingStatusColorConverter x:Key="BookingStatusColorConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <TextBlock HorizontalAlignment="Center" Text="{Binding BookingID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Center" Grid.Column="1" Text="{Binding ClientName}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Center" Grid.Column="2" Text="{Binding FriendName}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Center" Grid.Column="3" Text="{Binding Date, Converter={StaticResource DateFormatConverter}}" FontSize="12" Foreground="#424242" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Text="{Binding TimeRange}" FontSize="12" Foreground="#424242"/>
                <TextBlock HorizontalAlignment="Center" Text=" · " Foreground="#BDBDBD"/>
                <TextBlock HorizontalAlignment="Center" Text="{Binding MeetingLocation}" FontSize="12" Foreground="#757575" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Grid.Column="5" Text="{Binding TotalAmount, Converter={StaticResource MoneyFormatConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="#4CAF50" VerticalAlignment="Center"/>

            <Border Grid.Column="6" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center"
                    Background="{Binding Status, Converter={StaticResource BookingStatusColorConverter}}">
                <TextBlock Text="{Binding StatusDisplay}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
            </Border>

            <Border Grid.Column="7" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center"
                    Background="{Binding PaymentStatusBrush}">
                <TextBlock Text="{Binding PaymentStatusDisplay}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</UserControl>