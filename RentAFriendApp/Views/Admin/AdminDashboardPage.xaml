                                    <TextBlock Grid.Column="3"
                                               Text="Тип"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Дата"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Прочитано"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                </Grid>

                                <!-- Список сообщений -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" 
                                                        BorderBrush="#F0F0F0" 
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- ID сообщения -->
                                                        <TextBlock Text="{Binding MessageID}"
                                                                   FontSize="12"
                                                                   Foreground="#333333"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Отправитель -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="32" 
                                                                    Height="32" 
                                                                    Background="#9C27B0"
                                                                    CornerRadius="16"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SenderName, Converter={StaticResource InitialsConverter}}"
                                                                           Foreground="White"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding SenderName}"
                                                                       FontSize="12"
                                                                       Foreground="#333333"
                                                                       Margin="8,0,0,0"/>
                                                        </StackPanel>

                                                        <!-- Сообщение -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Content}"
                                                                   FontSize="12"
                                                                   Foreground="#333333"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="40"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- Тип -->
                                                        <Border Grid.Column="3"
                                                                Background="#E0E0E0"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding MessageType}"
                                                                       FontSize="11"
                                                                       Foreground="#333333"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Дата -->
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                                                   FontSize="11"
                                                                   Foreground="#666666"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Прочитано -->
                                                        <Border Grid.Column="5"
                                                                Background="{Binding IsRead, Converter={StaticResource ReadStatusColorConverter}}"
                                                                Width="24"
                                                                Height="24"
                                                                CornerRadius="12"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding IsRead, Converter={StaticResource ReadStatusTextConverter}}"
                                                                       Foreground="White"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Вкладка 5: Логи аудита -->
                    <TabItem Header="📋 Логи аудита">
                        <Border Style="{StaticResource AdminCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- Заголовки -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="ID"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Пользователь"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Действие"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Таблица"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="4"
                                               Text="RecordID"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Изменения"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="6"
                                               Text="Время"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                </Grid>

                                <!-- Список логов -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AuditLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" 
                                                        BorderBrush="#F0F0F0" 
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="150"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- ID лога -->
                                                        <TextBlock Text="{Binding LogID}"
                                                                   FontSize="12"
                                                                   Foreground="#333333"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Пользователь -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding UserName}"
                                                                       FontSize="12"
                                                                       Foreground="#333333"/>
                                                            <TextBlock Text="{Binding UserID, StringFormat=' (ID: {0})'}"
                                                                       FontSize="11"
                                                                       Foreground="#666666"/>
                                                        </StackPanel>

                                                        <!-- Действие -->
                                                        <Border Grid.Column="2"
                                                                Background="{Binding Action, Converter={StaticResource ActionTypeColorConverter}}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Action}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Таблица -->
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding TableName}"
                                                                   FontSize="12"
                                                                   Foreground="#333333"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- ID записи -->
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding RecordID}"
                                                                   FontSize="12"
                                                                   Foreground="#333333"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Изменения -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding OldValue, Converter={StaticResource TrimTextConverter}, ConverterParameter=20}"
                                                                       FontSize="11"
                                                                       Foreground="#999999"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBlock Text="→"
                                                                       FontSize="11"
                                                                       Foreground="#666666"/>
                                                            <TextBlock Text="{Binding NewValue, Converter={StaticResource TrimTextConverter}, ConverterParameter=20}"
                                                                       FontSize="11"
                                                                       Foreground="#4CAF50"
                                                                       Margin="5,0,0,0"/>
                                                        </StackPanel>

                                                        <!-- Время -->
                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding LoggedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}"
                                                                   FontSize="11"
                                                                   Foreground="#666666"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Вкладка 6: Система -->
                    <TabItem Header="⚙️ Система">
                        <Border Style="{StaticResource AdminCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Системная информация -->
                                <Border Grid.Row="0" 
                                        Background="#F0F7FF"
                                        CornerRadius="8"
                                        Padding="20"
                                        Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="📊 Системная информация"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2196F3"
                                                   Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="🖥️ Версия приложения: 1.0.0"
                                                           FontSize="13"
                                                           Foreground="#333333"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="🗄️ БД: SQL Server LocalDB"
                                                           FontSize="13"
                                                           Foreground="#333333"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="👤 Текущий админ: Администратор"
                                                           FontSize="13"
                                                           Foreground="#333333"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="📅 Запущено: 01.01.2024"
                                                           FontSize="13"
                                                           Foreground="#333333"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="⏱️ Время работы: 15 дн. 8 ч."
                                                           FontSize="13"
                                                           Foreground="#333333"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="✅ Статус: Работает нормально"
                                                           FontSize="13"
                                                           Foreground="#4CAF50"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Быстрые действия -->
                                <TextBlock Grid.Row="1"
                                           Text="⚡ Опасные действия"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           Margin="0,0,0,10"/>

                                <Border Grid.Row="2" 
                                        Background="#FFF5F5"
                                        CornerRadius="8"
                                        Padding="20"
                                        Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="🗑️ Очистить все логи"
                                                Style="{StaticResource DangerButton}"
                                                Height="40"
                                                Command="{Binding DeleteAllLogCommand}"/>

                                        <Button Grid.Column="1"
                                                Content="🔄 Перезапустить БД"
                                                Style="{StaticResource WarningButton}"
                                                Height="40"
                                                Margin="10,0"
                                                Click="RestartDbButton_Click"/>

                                        <Button Grid.Column="2"
                                                Content="📋 Резервное копирование"
                                                Style="{StaticResource SuccessButton}"
                                                Height="40"
                                                Click="BackupButton_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Статистика API -->
                                <TextBlock Grid.Row="3"
                                           Text="📈 Статистика использования"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           Margin="0,0,0,10"/>

                                <Border Grid.Row="4" 
                                        Background="#F8F9FA"
                                        CornerRadius="8"
                                        Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="1,245"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#4CAF50"/>
                                            <TextBlock Text="Запросов сегодня"
                                                       FontSize="12"
                                                       Foreground="#666666"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="98.7%"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#4CAF50"/>
                                            <TextBlock Text="Доступность API"
                                                       FontSize="12"
                                                       Foreground="#666666"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="45 мс"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#4CAF50"/>
                                            <TextBlock Text="Среднее время ответа"
                                                       FontSize="12"
                                                       Foreground="#666666"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                            <TextBlock Text="0"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#4CAF50"/>
                                            <TextBlock Text="Ошибок сегодня"
                                                       FontSize="12"
                                                       Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Индикатор загрузки -->
                <Border x:Name="LoadingOverlay" 
                        Background="#80000000" 
                        Visibility="Collapsed"
                        Panel.ZIndex="999">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="White" 
                                CornerRadius="12" 
                                Padding="30">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" 
                                             Height="4" 
                                             Width="200" 
                                             Margin="0,0,0,15"/>
                                <TextBlock Text="Загрузка данных..."
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Сообщения об ошибках -->
                <Border x:Name="ErrorPanel" 
                        Background="#FF5252" 
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,20"
                        Visibility="Collapsed"
                        Panel.ZIndex="1000">
                    <StackPanel>
                        <TextBlock x:Name="ErrorMessageText"
                                   FontSize="13"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                        <Button Content="✕"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                Margin="0,5,0,0"
                                Click="CloseErrorButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>