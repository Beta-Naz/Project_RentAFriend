<Page x:Class="RentAFriendApp.Views.Admin.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:convertes="clr-namespace:RentAFriendApp.Converters.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="Административная панель"
      Background="#F5F6FA">

    <Page.Resources>
        <convertes:InitialsConverter x:Key="InitialsConverter"/>
        <convertes:RoleToColorConverter x:Key="RoleToColorConverter"/>
        <convertes:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <convertes:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <convertes:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <convertes:BooleanToStatusTextConverter x:Key="BoolToStatusConverter"/>
        <convertes:VerificationStatusConverter x:Key="VerificationStatusConverter"/>
        <convertes:VerificationColorConverter x:Key="VerificationColorConverter"/>
        <convertes:TrimTextConverter x:Key="TrimTextConverter"/>
        <convertes:DateFormatConverter x:Key="DateFormatConverter"/>
        <convertes:MoneyFormatConverter x:Key="MoneyFormatConverter"/>
        <convertes:BookingStatusColorConverter x:Key="BookingStatusColorConverter"/>

        <!-- Цвета -->
        <Color x:Key="GreenColor">#4CAF50</Color>
        <Color x:Key="RedColor">#F44336</Color>
        <Color x:Key="BlueColor">#2196F3</Color>
        <Color x:Key="OrangeColor">#FF9800</Color>
        <Color x:Key="PurpleColor">#9C27B0</Color>
        <SolidColorBrush x:Key="GreenBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF9800"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#9C27B0"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="BgBrush" Color="#F5F6FA"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#757575"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

        <!-- Стиль кнопки действия -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль опасной кнопки -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль успешной кнопки -->
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource DangerBtn}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль карточки -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Стиль таба -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent" 
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                
                <!-- ============ ЗАГОЛОВОК ============ -->
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Административная панель" FontSize="22" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock Text="Управление пользователями, профилями, бронированиями и системой" 
                                   FontSize="13" Foreground="#757575" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔄 Обновить" Style="{StaticResource SuccessBtn}" 
                                Command="{Binding LoadDataCommand}" Margin="0,0,8,0"/>
                        <Button Content="📤 Экспорт" Style="{StaticResource DangerBtn}" 
                                Command="{Binding ExportDataCommand}" Background="#FF9800"/>
                    </StackPanel>
                </Grid>

                <!-- ============ ТАБЫ ============ -->
                <TabControl Background="Transparent" BorderThickness="0" 
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    
                    <!-- ===== ТАБ 1: ПОЛЬЗОВАТЕЛИ ===== -->
                    <TabItem Header="👥 Пользователи">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Фильтры -->
                                <Border Background="#F8F9FB" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <WrapPanel>
                                        <TextBox Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="240" Margin="0,0,10,0" Tag="🔍 Поиск по имени или email"/>
                                        <ComboBox ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding SelectedRoleFilter}"
                                                  Width="130" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}"
                                                  Width="140" Margin="0,0,10,0"/>
                                        <Button Content="Очистить фильтры" Background="Transparent" BorderBrush="#BDBDBD" 
                                                BorderThickness="1" Foreground="#757575" FontSize="12" Height="34" Padding="12,0"
                                                Cursor="Hand" Command="{Binding ClearSearchCommand}"/>
                                    </WrapPanel>
                                </Border>

                                <!-- Таблица -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AllUsers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="180"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding UserID}" FontSize="12" Foreground="#757575" 
                                                                   VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="36" Height="36" CornerRadius="18"
                                                                    Background="{Binding Role, Converter={StaticResource RoleToColorConverter}}">
                                                                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                                           Foreground="White" FontSize="12" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" 
                                                                           Foreground="#212121"/>
                                                                <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#757575"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="{Binding Email}" FontSize="12" 
                                                                   Foreground="#424242" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                                                                Background="{Binding Role, Converter={StaticResource RoleToColorConverter}}">
                                                            <TextBlock Text="{Binding Role}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <Border Grid.Column="4" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                                                                Background="{Binding IsActive, Converter={StaticResource StatusToColorConverter}}">
                                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                                       FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="5" FontSize="11" Foreground="#757575" VerticalAlignment="Center"
                                                                   Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}"/>

                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="🚫" ToolTip="Заблокировать" Style="{StaticResource ActionButton}"
                                                                    Foreground="#F44336"
                                                                    Command="{Binding DataContext.BlockUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <Button Content="✅" ToolTip="Разблокировать" Style="{StaticResource ActionButton}"
                                                                    Foreground="#4CAF50"
                                                                    Command="{Binding DataContext.UnblockUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                                                            <Button Content="🗑" ToolTip="Удалить" Style="{StaticResource ActionButton}"
                                                                    Foreground="#9E9E9E"
                                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ===== ТАБ 2: ПРОФИЛИ ДРУЗЕЙ ===== -->
                    <TabItem Header="⭐ Профили друзей">
                        <Border Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FriendProfiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="180"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding ProfileID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="36" Height="36" CornerRadius="18" Background="#4CAF50">
                                                            <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                                       Foreground="White" FontSize="12" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="#212121"/>
                                                            <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#757575"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Bio, Converter={StaticResource TrimTextConverter}, ConverterParameter=60}"
                                                               FontSize="12" Foreground="#616161" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Column="3" Text="{Binding City}" FontSize="12" Foreground="#424242" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Foreground="#4CAF50" VerticalAlignment="Center"
                                                               Text="{Binding HourlyRate, Converter={StaticResource MoneyFormatConverter}}"/>

                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⭐ " Foreground="#FFC107" FontSize="13"/>
                                                        <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}" FontSize="12" Foreground="#212121"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="6" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                                                            Background="{Binding IsVerified, Converter={StaticResource VerificationColorConverter}}">
                                                        <TextBlock Text="{Binding IsVerified, Converter={StaticResource VerificationStatusConverter}}"
                                                                   FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="✅" ToolTip="Верифицировать" Style="{StaticResource SuccessBtn}" Width="34" Height="34" Padding="0"
                                                                Command="{Binding DataContext.VerifyFriendCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                                                        <Button Content="❌" ToolTip="Отклонить" Style="{StaticResource DangerBtn}" Width="34" Height="34" Padding="0"
                                                                Command="{Binding DataContext.RejectFriendCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"
                                                                Margin="4,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- ===== ТАБ 3: БРОНИРОВАНИЯ ===== -->
                    <TabItem Header="📅 Бронирования">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Background="#F8F9FB" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <WrapPanel>
                                        <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#616161"/>
                                        <DatePicker SelectedDate="{Binding DateFrom}" Width="130" Margin="0,0,10,0" FontSize="12"/>
                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" Foreground="#616161"/>
                                        <DatePicker SelectedDate="{Binding DateTo}" Width="130" Margin="0,0,10,0" FontSize="12"/>
                                        <Button Content="Применить" Style="{StaticResource SuccessBtn}" 
                                                Command="{Binding ApplyDateFilterCommand}"/>
                                    </WrapPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AllBookings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding BookingID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ClientName}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FriendName}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Date, Converter={StaticResource DateFormatConverter}}" FontSize="12" Foreground="#424242" VerticalAlignment="Center"/>
                                                        
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="#424242"/>
                                                            <TextBlock Text=" · " Foreground="#BDBDBD"/>
                                                            <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#757575" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="5" Text="{Binding TotalAmount, Converter={StaticResource MoneyFormatConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="#4CAF50" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="6" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                                                                Background="{Binding Status, Converter={StaticResource BookingStatusColorConverter}}">
                                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <Border Grid.Column="7" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                                                                Background="{Binding PaymentStatusBrush}">
                                                            <TextBlock Text="{Binding PaymentStatusDisplay}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ===== ТАБ 4: СООБЩЕНИЯ ===== -->
                    <TabItem Header="💬 Сообщения">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Отправка всем -->
                                <Border Background="#F8F9FB" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BroadcastTitle, UpdateSourceTrigger=PropertyChanged}" 
                                                 Tag="Заголовок" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding BroadcastMessage, UpdateSourceTrigger=PropertyChanged}" 
                                                 Tag="Текст сообщения" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="📨 Отправить всем" Style="{StaticResource SuccessBtn}"
                                                Command="{Binding SendBroadcastCommand}" Height="36"/>
                                    </Grid>
                                </Border>

                                <!-- Список -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding MessageID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SenderName}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Content, Converter={StaticResource TrimTextConverter}, ConverterParameter=80}" 
                                                                   FontSize="12" Foreground="#616161" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Background="#E0E0E0">
                                                            <TextBlock Text="{Binding MessageType}" FontSize="10" Foreground="#424242"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="4" Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}, ConverterParameter='dd.MM.yyyy HH:mm'}" 
                                                                   FontSize="11" Foreground="#757575" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="5" Width="28" Height="28" CornerRadius="14"
                                                                Background="{Binding IsRead, Converter={StaticResource VerificationColorConverter}}"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding IsRead, Converter={StaticResource VerificationStatusConverter}}"
                                                                       FontSize="10" Foreground="White" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ===== ТАБ 5: ЛОГИ ===== -->
                    <TabItem Header="📋 Логи аудита">
                        <Border Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AuditLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding LogID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding UserName}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>

                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                                                            Background="{Binding ActionColor}">
                                                        <TextBlock Text="{Binding Action}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="{Binding TableName}" FontSize="12" Foreground="#424242" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding RecordID}" FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OldValue, Converter={StaticResource TrimTextConverter}, ConverterParameter=30}" FontSize="11" Foreground="#9E9E9E"/>
                                                        <TextBlock Text=" → " Foreground="#BDBDBD" FontSize="11"/>
                                                        <TextBlock Text="{Binding NewValue, Converter={StaticResource TrimTextConverter}, ConverterParameter=30}" FontSize="11" Foreground="#4CAF50"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="6" FontSize="11" Foreground="#757575" VerticalAlignment="Center"
                                                               Text="{Binding LoggedAt, Converter={StaticResource DateFormatConverter}, ConverterParameter='dd.MM.yyyy HH:mm:ss'}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- ===== ТАБ 6: ОТЗЫВЫ ===== -->
                    <TabItem Header="⭐ Отзывы">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Статистика -->
                                <Border Background="#F8F9FB" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <WrapPanel>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" Foreground="#616161">
                        <Run Text="На модерации: "/>
                        <Run Text="{Binding PendingReviewsCount}" FontWeight="Bold" Foreground="#FF9800"/>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#616161">
                        <Run Text="Одобрено сегодня: "/>
                        <Run Text="{Binding ApprovedTodayCount}" FontWeight="Bold" Foreground="#4CAF50"/>
                                        </TextBlock>
                                    </WrapPanel>
                                </Border>

                                <!-- Список отзывов -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding PendingReviews}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- ID -->
                                                        <TextBlock Text="{Binding ReviewID, StringFormat='#{0}'}" 
                                               FontSize="12" Foreground="#757575" VerticalAlignment="Top" Margin="0,4,0,0"/>

                                                        <!-- Контент отзыва -->
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                            <!-- Заголовок и звёзды -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="#212121" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Margin="10,0,0,0" FontSize="13">
                                                <Run Text="⭐ " Foreground="#FFC107"/>
                                                <Run Text="{Binding Rating, StringFormat={}{0}/5}" Foreground="#212121" FontWeight="SemiBold"/>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <!-- Текст отзыва -->
                                                            <TextBlock Text="{Binding Comment}" FontSize="12" Foreground="#616161" 
                                                   TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,6"/>

                                                            <!-- Мета-информация -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="11" Foreground="#9E9E9E">
                                                <Run Text="Автор: "/>
                                                <Run Text="{Binding ClientName}" FontWeight="SemiBold" Foreground="#424242"/>
                                                                </TextBlock>
                                                                <TextBlock Text=" · " FontSize="11" Foreground="#BDBDBD"/>
                                                                <TextBlock FontSize="11" Foreground="#9E9E9E">
                                                <Run Text="Бронирование №"/>
                                                <Run Text="{Binding BookingID}"/>
                                                                </TextBlock>
                                                                <TextBlock Text=" · " FontSize="11" Foreground="#BDBDBD"/>
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" 
                                                       FontSize="11" Foreground="#9E9E9E"/>
                                                            </StackPanel>

                                                            <!-- Поле причины отклонения (скрыто по умолчанию) -->
                                                            <Border x:Name="RejectReasonPanel" Background="#FFF3E0" CornerRadius="6" 
                                                Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                                                                <StackPanel>
                                                                    <TextBlock Text="Причина отклонения:" FontSize="11" Foreground="#E65100" Margin="0,0,0,4"/>
                                                                    <TextBox x:Name="RejectReasonBox" FontSize="12" Height="60"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Tag="Укажите причину отклонения отзыва..."/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Кнопки действий -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0" Width="100">
                                                            <Button Content="✅ Одобрить" Style="{StaticResource SuccessBtn}" 
                                                Width="100" Margin="0,0,0,6"
                                                Click="ApproveReview_Click" Tag="{Binding ReviewID}"/>
                                                            <Button Content="❌ Отклонить" Style="{StaticResource DangerBtn}" 
                                                Width="100" Margin="0,0,0,6"
                                                Click="RejectReview_Click" Tag="{Binding ReviewID}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Пустое состояние -->
                                    <Border x:Name="NoReviewsPlaceholder" Visibility="Collapsed" Padding="40" HorizontalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="✅" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="Все отзывы обработаны" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Нет отзывов, ожидающих модерации" FontSize="13" 
                                   Foreground="#757575" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ===== ТАБ 7: СИСТЕМА ===== -->
                    <TabItem Header="⚙️ Система">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- Информация -->
                                <Border Background="#E8F5E9" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Версия приложения" FontSize="11" Foreground="#616161"/>
                                            <TextBlock Text="1.0.0" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Пользователей онлайн" FontSize="11" Foreground="#616161"/>
                                            <TextBlock Text="{Binding OnlineUsers}" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Статистика -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F8F9FB" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Всего пользователей" FontSize="11" Foreground="#757575"/>
                                            <TextBlock Text="{Binding TotalUsers}" FontSize="22" FontWeight="Bold" Foreground="#212121"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#F8F9FB" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Активных бронирований" FontSize="11" Foreground="#757575"/>
                                            <TextBlock Text="{Binding TotalBookings}" FontSize="22" FontWeight="Bold" Foreground="#212121"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Опасные действия -->
                                <TextBlock Text="Опасные действия" FontSize="14" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,10"/>
                                <Border Background="#FFF3E0" CornerRadius="8" Padding="14">
                                    <WrapPanel>
                                        <Button Content="🗑 Очистить логи" Style="{StaticResource DangerBtn}" 
                                                Command="{Binding DeleteAllLogCommand}" Margin="0,0,10,0"/>
                                        <Button Content="🔄 Перезапустить БД" Background="#FF9800" Foreground="White" 
                                                FontSize="12" FontWeight="SemiBold" Height="34" Padding="16,0" BorderThickness="0"
                                                Cursor="Hand" Margin="0,0,10,0" Click="RestartDbButton_Click"/>
                                        <Button Content="💾 Резервное копирование" Style="{StaticResource SuccessBtn}"
                                                Click="BackupButton_Click"/>
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>

                </TabControl>

                <!-- Оверлей загрузки -->
                <Border x:Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="White" CornerRadius="12" Padding="30">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="4" Width="200" Margin="0,0,0,15"/>
                                <TextBlock Text="Загрузка..." FontSize="14" FontWeight="SemiBold" Foreground="#212121" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Панель ошибок -->
                <Border x:Name="ErrorPanel" Background="#F44336" CornerRadius="8" Padding="14"
                        Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid>
                        <TextBlock x:Name="ErrorMessageText" FontSize="13" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="14" Cursor="Hand" Click="CloseErrorButton_Click"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>