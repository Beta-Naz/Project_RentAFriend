                                                                           Foreground="White"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding FullName}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#333333"/>
                                                                <TextBlock Text="{Binding Phone}"
                                                                           FontSize="11"
                                                                           Foreground="#666666"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Email -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Email}"
                                                                   FontSize="12"
                                                                   Foreground="#333333"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- Роль -->
                                                        <Border Grid.Column="3"
                                                                Background="{Binding Role, Converter={StaticResource RoleToColorConverter}}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Role}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Статус -->
                                                        <Border Grid.Column="4"
                                                                Background="{Binding IsActive, Converter={StaticResource StatusToColorConverter}}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Дата регистрации -->
