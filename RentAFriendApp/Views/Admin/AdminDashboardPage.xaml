                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="40" 
                                                                    Height="40" 
                                                                    Background="#4CAF50"
                                                                    CornerRadius="20"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                                           Foreground="White"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding FullName}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#333333"/>
                                                                <TextBlock Text="{Binding Email}"
                                                                           FontSize="11"
                                                                           Foreground="#666666"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Описание -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Bio, Converter={StaticResource TrimTextConverter}, ConverterParameter=50}"
                                                                   FontSize="12"
                                                                   Foreground="#666666"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="40"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- Город -->
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding City}"
                                                                   FontSize="12"
                                                                   Foreground="#333333"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Ставка -->
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding HourlyRate, StringFormat='{}{0:C}/час'}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#4CAF50"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Рейтинг -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⭐"
                                                                       FontSize="12"
                                                                       Foreground="#FFC107"/>

                                                            <TextBlock Text="{Binding AverageRating, StringFormat={}{0:0.0}}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#333333"
                                                                       Margin="4,0,0,0"/>
                                                        </StackPanel>

                                                        <!-- Статус верификации -->
                                                        <Border Grid.Column="6"
                                                                Background="{Binding IsVerified, Converter={StaticResource VerificationStatusColorConverter}}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
