                                               Text="Время"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Сумма"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="6"
                                               Text="Статус"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="7"
                                               Text="Оплата"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
