                                                                    ToolTip="Разблокировать"
                                                                    Style="{StaticResource SuccessButton}"
                                                                    Command="{Binding DataContext.UnblockUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="32"
                                                                    Height="32"
                                                                    Margin="0,0,5,0"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=reverse}"/>
                                                            <Button Content="🗑️"
                                                                    ToolTip="Удалить"
                                                                    Style="{StaticResource DangerButton}"
                                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="32"
                                                                    Height="32"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Вкладка 2: Профили друзей -->
                    <TabItem Header="⭐ Профили друзей">
                        <Border Style="{StaticResource AdminCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- Заголовки -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="ID"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Друг"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Описание"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Город"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Ставка"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Рейтинг"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"/>
                                    <TextBlock Grid.Column="6"
                                               Text="Статус"
                                               FontSize="11"
                                               FontWeight="SemiBold"
