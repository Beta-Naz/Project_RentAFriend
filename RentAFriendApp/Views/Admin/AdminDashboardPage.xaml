                                                                    ToolTip="Подробнее"
                                                                    Background="Transparent"
                                                                    BorderBrush="#9C27B0"
                                                                    BorderThickness="1"
                                                                    Foreground="#9C27B0"
                                                                    Width="32"
                                                                    Height="32"
                                                                    FontSize="12"
                                                                    Click="DetailsUserButton_Click"
                                                                    Tag="{Binding UserID}"/>
                                                        </StackPanel>

                                                        <!-- Быстрые действия -->
                                                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="🚫"
                                                                    ToolTip="Заблокировать"
                                                                    Style="{StaticResource DangerButton}"
