                                                                    BorderBrush="#2196F3"
                                                                    BorderThickness="1"
                                                                    Foreground="#2196F3"
                                                                    Width="32"
                                                                    Height="32"
                                                                    FontSize="12"
                                                                    Margin="0,0,5,0"
                                                                    Click="ViewUserButton_Click"
                                                                    Tag="{Binding UserID}"/>
                                                            <Button Content="✏️"
                                                                    ToolTip="Редактировать"
                                                                    Background="Transparent"
                                                                    BorderBrush="#4CAF50"
                                                                    BorderThickness="1"
                                                                    Foreground="#4CAF50"
                                                                    Width="32"
                                                                    Height="32"
                                                                    FontSize="12"
                                                                    Margin="0,0,5,0"
