                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Действия -->
                                                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="✅"
                                                                    ToolTip="Верифицировать"
                                                                    Style="{StaticResource SuccessButton}"
                                                                    Command="{Binding DataContext.VerifyFriendCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="32"
                                                                    Height="32"
                                                                    Margin="0,0,5,0"
                                                                    Visibility="{Binding IsVerified, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=reverse}"/>
                                                            <Button Content="❌"
                                                                    ToolTip="Отклонить"
