<Page x:Class="RentAFriendApp.Views.Admin.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RentAFriendApp.Views.Admin"
      xmlns:vm="clr-namespace:RentAFriendApp.ViewModels.Admin"
      xmlns:convertes="clr-namespace:RentAFriendApp.Converters.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="Административная панель"
      Background="#F8F9FA">

    <Page.Resources>
        <!-- Стили для административной панели -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="Border"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6">
                    <Path x:Name="Arrow"
                  Data="M0,0 L4,4 L8,0 Z"
                  Fill="#666666"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="8"
                  Height="8"/>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5252"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F57C00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Конвертеры -->
        <convertes:InitialsConverter x:Key="InitialsConverter"/>
        <convertes:RoleToColorConverter x:Key="RoleToColorConverter"/>
        <convertes:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <convertes:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <convertes:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <convertes:TrimTextConverter x:Key="TrimTextConverter"/>
        <convertes:VerificationStatusColorConverter x:Key="VerificationStatusColorConverter"/>
        <convertes:ActionTypeColorConverter x:Key="ActionTypeColorConverter"/>
        <convertes:ReadStatusTextConverter x:Key="ReadStatusTextConverter"/>
        <convertes:ReadStatusColorConverter x:Key="ReadStatusColorConverter"/>
        <convertes:BookingStatusColorConverter x:Key="BookingStatusColorConverter"/>
        <convertes:VerificationStatusTextConverter x:Key="VerificationStatusTextConverter"/>

        <!-- Иконки -->
        <Geometry x:Key="ShieldIcon">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5C13.66,5 15,6.34 15,8C15,9.66 13.66,11 12,11C10.34,11 9,9.66 9,8C9,6.34 10.34,5 12,5M12,13C14.76,13 17,15.24 17,18C17,20.76 14.76,23 12,23C9.24,23 7,20.76 7,18C7,15.24 9.24,13 12,13M12,15C10.34,15 9,16.34 9,18C9,19.66 10.34,21 12,21C13.66,21 15,19.66 15,18C15,16.34 13.66,15 12,15Z</Geometry>
        <Geometry x:Key="UsersIcon">M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z</Geometry>
        <Geometry x:Key="CalendarIcon">M9,1V3H15V1H17V3H21C22.11,3 23,3.89 23,5V21C23,22.11 22.11,23 21,23H3C1.89,23 1,22.11 1,21V5C1,3.89 1.89,3 3,3H7V1H9M7,7V9H9V7H7M11,7V9H13V7H11M15,7V9H17V7H15M19,7V9H21V7H19M3,10V21H21V10H3M7,11V13H9V11H7M11,11V13H13V11H11M15,11V13H17V11H15M19,11V13H21V11H19Z</Geometry>
        <Geometry x:Key="MoneyIcon">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4M12,6C9.79,6 8,7.79 8,10C8,12.21 9.79,14 12,14C14.21,14 16,12.21 16,10C16,7.79 14.21,6 12,6M12,8C13.1,8 14,8.9 14,10C14,11.1 13.1,12 12,12C10.9,12 10,11.1 10,10C10,8.9 10.9,8 12,8Z</Geometry>
        <Geometry x:Key="VerifiedIcon">M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</Geometry>
        <Geometry x:Key="BlockIcon">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C16.42,4 20,7.58 20,12C20,16.42 16.42,20 12,20C7.58,20 4,16.42 4,12C4,7.58 7.58,4 12,4M12,5C8.14,5 5,8.14 5,12C5,15.86 8.14,19 12,19C15.86,19 19,15.86 19,12C19,8.14 15.86,5 12,5Z</Geometry>
        <Geometry x:Key="DeleteIcon">M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8.46,11.88L9.87,10.47L12,12.59L14.12,10.47L15.53,11.88L13.41,14L15.53,16.12L14.12,17.53L12,15.41L9.88,17.53L8.47,16.12L10.59,14L8.46,11.88M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z</Geometry>
        <Geometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="ExportIcon">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</Geometry>
        <Geometry x:Key="MessageIcon">M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2Z</Geometry>
        <Geometry x:Key="LogIcon">M14,12H10V10H14M14,16H10V14H14M20,8H17V6A3,3 0 0,0 14,3H10A3,3 0 0,0 7,6V8H4A2,2 0 0,0 2,10V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,20V10A2,2 0 0,0 20,8M9,6A1,1 0 0,1 10,5H14A1,1 0 0,1 15,6V8H9V6Z</Geometry>

    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <!-- Заголовок панели -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="#4CAF50"
                                Width="48"
                                Height="48"
                                CornerRadius="10"
                                VerticalAlignment="Center">
                            <Path Data="{StaticResource ShieldIcon}"
                                  Fill="White"
                                  Width="24"
                                  Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ Административная панель"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#333333"/>
                            <TextBlock Text="Полный контроль над системой RentAFriend"
                                       FontSize="13"
                                       Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Быстрые действия -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="🔄 Обновить"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding LoadDataCommand}"
                                Width="120"
                                Margin="0,0,10,0"/>
                        <Button Content="📤 Экспорт"
                                Style="{StaticResource WarningButton}"
                                Command="{Binding ExportDataCommand}"
                                Width="100"/>
                    </StackPanel>
                </Grid>

                <!-- Основная статистика -->
                <Grid Visibility="Collapsed" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Карточка: Все пользователи -->
                    <Border Style="{StaticResource AdminCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#E3F2FD"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource UsersIcon}"
                                          Fill="#2196F3"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Все пользователи"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                    <TextBlock Text="{Binding TotalUsers}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#2196F3"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ActiveUsers, StringFormat='Активных: {0}'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BlockedUsers, StringFormat='Заблокировано: {0}'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Карточка: Друзья -->
                    <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#E8F5E8"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource VerifiedIcon}"
                                          Fill="#4CAF50"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Верифицированные друзья"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                    <TextBlock Text="{Binding FriendsCount}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#4CAF50"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PendingVerifications, StringFormat='На проверке: {0}'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Path=FriendProfiles.Count, StringFormat='Всего: {0}'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Карточка: Бронирования -->
                    <Border Grid.Column="4" Style="{StaticResource AdminCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#FFF3E0"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource CalendarIcon}"
                                          Fill="#FF9800"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Все бронирования"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                    <TextBlock Text="{Binding TotalBookings}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#FF9800"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TotalRevenue, StringFormat='Выручка: {0:C}'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                                <TextBlock Grid.Column="1"
                                           Text="За период"
                                           FontSize="12"
                                           Foreground="#666666"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Карточка: Администраторы -->
                    <Border Grid.Column="6" Style="{StaticResource AdminCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#F3E5F5"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource ShieldIcon}"
                                          Fill="#9C27B0"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Администраторы"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                    <TextBlock Text="{Binding AdminsCount}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#9C27B0"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ModeratorsCount, StringFormat='Модераторов: {0}'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                                <TextBlock Grid.Column="1"
                                           Text="Вы: Админ"
                                           FontSize="12"
                                           Foreground="#666666"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Основной контент: Табы -->
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="border" 
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="0,0,10,0">
                                            <ContentPresenter x:Name="contentPresenter"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#4CAF50"/>
                                                <Setter TargetName="border" Property="CornerRadius" Value="6"/>
                                                <Setter TargetName="border" Property="Padding" Value="15,8"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Вкладка 1: Управление пользователями -->
                    <TabItem Header="👥 Пользователи">
                        <Border Style="{StaticResource AdminCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- Фильтры -->
                                <Border Grid.Row="0" 
                                        Background="#F8F9FA"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Поиск -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Path Data="{StaticResource SearchIcon}"
                                                  Fill="#666666"
                                                  Width="20"
                                                  Height="20"
                                                  VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="300"
                                                     Margin="10,0,0,0"
                                                     Padding="10"
                                                     Background="White"
                                                     BorderBrush="#E0E0E0"
                                                     BorderThickness="1"
                                                     FontSize="13"
                                                     VerticalAlignment="Center">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border x:Name="border" 
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                                        <ScrollViewer x:Name="PART_ContentHost" 
                                                                                      Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsFocused" Value="True">
                                                                            <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>

                                        <!-- Фильтр по роли -->
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding RoleFilters}"
                                                  SelectedItem="{Binding SelectedRoleFilter}"
                                                  Width="120"
                                                  Margin="15,0,0,0"
                                                  Padding="8"
                                                  FontSize="12"
                                                  VerticalAlignment="Center">
                                        </ComboBox>

                                        <!-- Фильтр по статусу -->
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding StatusFilters}"
                                                  SelectedItem="{Binding SelectedStatusFilter}"
                                                  Width="120"
                                                  Margin="10,0,0,0"
                                                  Padding="8"
                                                  FontSize="12"
                                                  VerticalAlignment="Center">
                                            <ComboBox.Style>
                                                <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox"/>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <!-- Кнопка сброса -->
                                        <Button Grid.Column="3"
                                                Content="🗑️ Очистить"
                                                Command="{Binding ClearSearchCommand}"
                                                Background="Transparent"
                                                BorderBrush="#666666"
                                                BorderThickness="1"
                                                Foreground="#666666"
                                                FontSize="12"
                                                Height="32"
                                                Margin="10,0,0,0"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" 
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
