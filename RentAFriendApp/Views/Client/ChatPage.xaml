<Page x:Class="RentAFriendApp.Views.Client.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:converters="clr-namespace:RentAFriendApp.Converters" 
      xmlns:models="clr-namespace:RentAFriendApp.Models" 
      xmlns:client="clr-namespace:RentAFriendApp.ViewModels.Client"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Сообщения - RentAFriend"
      Background="#F8F9FA"
      Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToInverseVisibilityConverter x:Key="BooleanToInverseVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToChatCardStyleConverter x:Key="BooleanToChatCardStyleConverter"/>
        <converters:DateTimeToTimeConverter x:Key="DateTimeToTimeConverter"/>
        <converters:DateTimeToChatTimeConverter x:Key="DateTimeToChatTimeConverter"/>
        <!-- Стили для сообщений -->
        <Style x:Key="IncomingMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18,18,18,4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutgoingMessageStyle" TargetType="Border" BasedOn="{StaticResource IncomingMessageStyle}">
            <Setter Property="Background" Value="#E8F5E8"/>
            <Setter Property="CornerRadius" Value="18,18,4,18"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Стиль для карточки чата -->
        <Style x:Key="ChatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для активной карточки чата -->
        <Style x:Key="ActiveChatCardStyle" TargetType="Border" BasedOn="{StaticResource ChatCardStyle}">
            <Setter Property="Background" Value="#F0F9F0"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Стили для кнопок -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Иконки -->
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="SendIcon">M2,21L23,12L2,3V10L17,12L2,14V21Z</Geometry>
        <Geometry x:Key="AttachmentIcon">M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z</Geometry>
        <Geometry x:Key="EmojiIcon">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M7,9.5C7,8.67 7.67,8 8.5,8C9.33,8 10,8.67 10,9.5C10,10.33 9.33,11 8.5,11C7.67,11 7,10.33 7,9.5M12,17.5C9.67,17.5 7.69,16.04 6.89,14H17.11C16.31,16.04 14.33,17.5 12,17.5M15.5,11C14.67,11 14,10.33 14,9.5C14,8.67 14.67,8 15.5,8C16.33,8 17,8.67 17,9.5C17,10.33 16.33,11 15.5,11Z</Geometry>
        <Geometry x:Key="OnlineIcon">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2Z</Geometry>
        <Geometry x:Key="OfflineIcon">M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2Z</Geometry>
        <Geometry x:Key="DotsIcon">M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z</Geometry>
        <Geometry x:Key="PhoneIcon">M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z</Geometry>
        <Geometry x:Key="VideoIcon">M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z</Geometry>
        <Geometry x:Key="BackIcon">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</Geometry>
        <Geometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="NewChatIcon">M15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4M15,5.9C16.16,5.9 17.1,6.84 17.1,8C17.1,9.16 16.16,10.1 15,10.1C13.84,10.1 12.9,9.16 12.9,8C12.9,6.84 13.84,5.9 15,5.9M4,7V10H1V12H4V15H6V12H9V10H6V7H4M15,13C12.33,13 7,14.33 7,17V20H23V17C23,14.33 17.67,13 15,13M15,14.9C17.97,14.9 21.1,16.36 21.1,17V18.1H8.9V17C8.9,16.36 12,14.9 15,14.9Z</Geometry>
    </Page.Resources>

    <Grid>
        <!-- Панель поиска чатов -->
        <Border
                x:Name="SearchPanel"
                Width="320"
                Background="White" 
                Margin="0,0,1,0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0"
                HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Grid.Row="0" 
                        Background="White"
                        Padding="20"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Сообщения"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="RefreshButton_Click"
                                    ToolTip="Обновить чаты">
                                <Path Data="{StaticResource RefreshIcon}"
                                      Fill="#666666"
                                      Width="23"
                                      Height="23"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="MenuButton_Click"
                                    Margin="8,0,0,0"
                                    ToolTip="Меню">
                                <Path Data="{StaticResource DotsIcon}"
                                      Fill="#666666"
                                      Width="23"
                                      Height="23"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Поиск чатов -->
                <Border Grid.Row="1" 
                        Background="White"
                        Padding="15">
                    <Border Background="#F5F5F5"
                            CornerRadius="20"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Data="{StaticResource SearchIcon}"
                                  Fill="#999999"
                                  Width="23"
                                  Height="23"
                                  VerticalAlignment="Center"/>

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     Margin="8,0,8,0"
                                     Foreground="#333333"
                                     Text="Поиск чатов..."
                                     GotFocus="SearchTextBox_GotFocus"
                                     LostFocus="SearchTextBox_LostFocus"
                                     TextChanged="SearchTextBox_TextChanged"
                                     KeyDown="SearchTextBox_KeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Button x:Name="ClearSearchButton"
                                    Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="ClearSearchButton_Click"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource NullToVisibilityConverter}}"
                                    ToolTip="Очистить поиск">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="#999999"
                                      Width="23"
                                      Height="23"/>
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <!-- Список чатов -->
                <ScrollViewer Grid.Row="2" 
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="ChatList"
                                  ItemsSource="{Binding FilteredChats}"
                                  SelectionChanged="ChatList_SelectionChanged"
                                  ContextMenuOpening="ChatList_ContextMenuOpening"
                                  MouseDoubleClick="ChatList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Аватар -->
                                        <Border Grid.Column="0" 
                                                Width="48"
                                                Height="48"
                                                Background="{Binding AvatarBackground}"
                                                CornerRadius="24"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#4CAF50"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Информация о чате -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"/>

                                            <TextBlock Text="{Binding LastMessage}"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Время и счетчик -->
                                        <StackPanel Grid.Column="2" 
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LastMessageTimeDisplay}"
                                                       FontSize="11"
                                                       Foreground="#999999"/>

                                            <Border Width="18"
                                                    Height="18"
                                                    Background="#4CAF50"
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,4,0,0"
                                                    Visibility="{Binding HasUnreadMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding UnreadCount}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="15,0,15,8"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#F0F9F0"/>
                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Панель чата -->
        <Grid x:Name="ChatPanel" 
              Margin="320,0,0,0"
              Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка чата -->
            <Border Grid.Row="0" 
                    Background="White"
                    Padding="20"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка "Назад" -->
                    <Button x:Name="BackToChatsButton"
                            Grid.Column="0"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,12,0"
                            Click="BackToChatsButton_Click"
                            ToolTip="Назад к списку чатов">
                        <Path Data="{StaticResource BackIcon}"
                              Fill="#666666"
                              Width="24"
                              Height="24"/>
                    </Button>

                    <!-- Информация о собеседнике -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedChat.UserName}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"/>
                    </StackPanel>

                    <!-- Действия -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding SelectedChat, Converter={StaticResource NullToVisibilityConverter}}">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,8,0"
                                Click="CallButton_Click"
                                Tag="{Binding SelectedChat.ClientID}"
                                ToolTip="Позвонить">
                            <Path Data="{StaticResource PhoneIcon}"
                                  Fill="#4CAF50"
                                  Width="24"
                                  Height="24"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="VideoCallButton_Click"
                                Tag="{Binding SelectedChat.ClientID}"
                                ToolTip="Видеозвонок">
                            <Path Data="{StaticResource VideoIcon}"
                                  Fill="#4CAF50"
                                  Width="24"
                                  Height="24"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Область сообщений -->
            <Border Grid.Row="1" 
                    Background="#FAFAFA">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              Padding="20"
                              x:Name="MessagesScrollViewer">
                    <Grid>

                    <!-- Пока нет сообщений -->
                        <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                x:Name="noMessages">
                            <Path Data="{StaticResource NewChatIcon}"
                              Fill="#E0E0E0"
                              Width="64"
                              Height="64"
                              Margin="0,0,0,16"/>
                            <TextBlock Text="Начните диалог"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   TextAlignment="Center"/>
                            <TextBlock Text="Отправьте первое сообщение"
                                   FontSize="14"
                                   Foreground="#999999"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center"/>
                        </StackPanel>
                        <!-- Список сообщений -->
                        <ItemsControl x:Name="MessagesList"
                                  ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="CornerRadius" Value="18,18,18,4"/>
                                                    <Setter Property="Padding" Value="16"/>
                                                    <Setter Property="MaxWidth" Value="400"/>
                                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="1"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="Background" Value="#E8F5E8"/>
                                                            <Setter Property="CornerRadius" Value="18,18,4,18"/>
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}"
                                                       FontSize="14"
                                                       Foreground="#333333"
                                                       TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TimeDisplay}"
                                                           FontSize="11"
                                                           Foreground="#999999"/>
                                                    <Path Data="M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8L10,17Z"
                                                      Width="24"
                                                      Height="24"
                                                      Fill="#4CAF50"
                                                      Visibility="{Binding IsRead, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Панель ввода сообщения -->
            <Border Grid.Row="2" 
                    Background="White"
                    Padding="20"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding SelectedChat, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки действий -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,8,0"
                                Click="AttachFileButton_Click"
                                ToolTip="Прикрепить файл">
                            <Path Data="{StaticResource AttachmentIcon}"
                                  Fill="#666666"
                                  Width="24"
                                  Height="24"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="EmojiButton_Click"
                                ToolTip="Эмодзи">
                            <Path Data="{StaticResource EmojiIcon}"
                                  Fill="#666666"
                                  Width="24"
                                  Height="24"/>
                        </Button>
                    </StackPanel>

                    <!-- Поле ввода -->
                    <Border Grid.Column="1" 
                            Background="#F5F5F5"
                            CornerRadius="20"
                            Margin="8,0,8,0"
                            Padding="16,12">
                        <TextBox VerticalContentAlignment="Center"
                                 x:Name="MessageTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Foreground="#333333"
                                 GotFocus="MessageTextBox_GotFocus"
                                 LostFocus="MessageTextBox_LostFocus"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 VerticalScrollBarVisibility="Auto"
                                 KeyDown="MessageTextBox_KeyDown"
                                 Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              Margin="0"
                                                              VerticalScrollBarVisibility="Auto"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Кнопка отправки -->
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Background="#4CAF50"
                            Click="SendMessageButton_Click"
                            IsEnabled="{Binding CanSendMessage}"
                            ToolTip="Отправить сообщение">
                        <Path Data="{StaticResource SendIcon}"
                              Fill="White"
                              Width="24"
                              Height="24"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>