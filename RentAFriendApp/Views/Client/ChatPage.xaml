<Page x:Class="RentAFriendApp.Views.Client.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:converters="clr-namespace:RentAFriendApp.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="Сообщения"
      Background="#F8F9FA"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <!-- Стиль карточки -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-иконка -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка отправки -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="22">
                            <TextBlock Text="▶" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ ПАНЕЛЬ: СПИСОК ЧАТОВ ===== -->
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Padding="20,18" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="💬 Сообщения" FontSize="18" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                                Command="{Binding RefreshCommand}" ToolTip="Обновить">
                            <TextBlock Text="🔄" FontSize="18"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Поиск -->
                <Border Grid.Row="1" Padding="16,12" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                    <Border Background="#F5F5F5" CornerRadius="10" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="13"
                                     Foreground="#333333" VerticalAlignment="Center"
                                     Tag="Поиск чатов..."/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Список чатов -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredChats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,14" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                        Cursor="Hand" Background="White"
                                        MouseLeftButtonDown="ChatItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Аватар -->
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#E8F5E8">
                                            <TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Имя + последнее сообщение -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InterlocutorName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LastMessage}" FontSize="12" Foreground="#999999"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" MaxHeight="16"/>
                                        </StackPanel>

                                        <!-- Время + счётчик -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding LastMessageTimeDisplay}" FontSize="11"
                                                       Foreground="#BDBDBD" HorizontalAlignment="Right"/>
                                            <Border Width="20" Height="20" CornerRadius="10" Background="#4CAF50"
                                                    HorizontalAlignment="Right" Margin="0,6,0,0"
                                                    Visibility="{Binding HasUnreadMessages, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding UnreadCount}" FontSize="10" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        

                    <!-- Нет чатов -->
                    <Border Padding="40" Visibility="{Binding HasNoChats, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💬" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Нет активных чатов" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#999999" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== ПРАВАЯ ПАНЕЛЬ: ПЕРЕПИСКА ===== -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Border Padding="20,16" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasSelectedChat, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#E8F5E8">
                            <TextBlock Text="{Binding SelectedChat.Initials}" FontSize="14" FontWeight="Bold"
                                       Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedChat.InterlocutorName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#333333" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Сообщения -->
                <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto"
                              Background="#FAFAFA" Padding="20">
                    <Grid>
                        <!-- Нет сообщений -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoMessages, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Начните диалог" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#999999" HorizontalAlignment="Center"/>
                            <TextBlock Text="Отправьте первое сообщение" FontSize="13"
                                       Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Список -->
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" MaxWidth="420">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="CornerRadius" Value="16,16,16,4"/>
                                                <Setter Property="Padding" Value="14,10"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E8"/>
                                                        <Setter Property="CornerRadius" Value="16,16,4,16"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#333333" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding CreatedAt, StringFormat=HH:mm}" FontSize="10" Foreground="#BDBDBD"/>
                                                <TextBlock Text=" ✓" FontSize="10" Foreground="#4CAF50"
                                                           Visibility="{Binding IsRead, Converter={StaticResource BoolToVisibility}}"
                                                           Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Ввод -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0"
                        Visibility="{Binding HasSelectedChat, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#F5F5F5" CornerRadius="12" Padding="14,10">
                            <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="13"
                                     Foreground="#333333" VerticalAlignment="Center"
                                     Tag="Напишите сообщение..."
                                     KeyDown="MessageTextBox_KeyDown"/>
                        </Border>

                        <Button Grid.Column="1" Style="{StaticResource SendButton}" Margin="10,0,0,0"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding CanSendMessage}"
                                ToolTip="Отправить"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>