<Page x:Class="RentAFriendApp.Views.Client.MyBookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RentAFriendApp.Views.Client"
      xmlns:converters="clr-namespace:RentAFriendApp.Converters" 
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Мои бронирования"
      Background="#F8F9FA"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Конвертеры -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StatusToTextConverter x:Key="StatusToTextConverter"/>
        <converters:DateTimeToShortDateConverter x:Key="DateTimeToShortDateConverter"/>
        <converters:TimeSpanToDurationConverter x:Key="TimeSpanToDurationConverter"/>

        <!-- Стили для карточек -->
        <Style x:Key="StatsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BookingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                             To="3" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                             To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.06" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F5E8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#388E3C"/>
                                <Setter Property="Foreground" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для активной кнопки фильтра -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Иконки -->
        <Geometry x:Key="CalendarIcon">M9,1V3H15V1H17V3H21C22.11,3 23,3.89 23,5V21C23,22.11 22.11,23 21,23H3C1.89,23 1,22.11 1,21V5C1,3.89 1.89,3 3,3H7V1H9M7,7V9H9V7H7M11,7V9H13V7H11M15,7V9H17V7H15M19,7V9H21V7H19M3,10V21H21V10H3Z</Geometry>
        <Geometry x:Key="ClockIcon">M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="MoneyIcon">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4M12,6C9.79,6 8,7.79 8,10C8,12.21 9.79,14 12,14C14.21,14 16,12.21 16,10C16,7.79 14.21,6 12,6M12,8C13.1,8 14,8.9 14,10C14,11.1 13.1,12 12,12C10.9,12 10,11.1 10,10C10,8.9 10.9,8 12,8Z</Geometry>
        <Geometry x:Key="FilterIcon">M14,12V19.88C14.04,20.18 13.94,20.5 13.71,20.71C13.32,21.1 12.69,21.1 12.3,20.71L10.29,18.7C10.06,18.47 9.96,18.16 10,17.87V12H9.97L4.21,4.62C3.87,4.19 3.95,3.56 4.38,3.22C4.57,3.08 4.78,3 5,3V3H19V3C19.22,3 19.43,3.08 19.62,3.22C20.05,3.56 20.13,4.19 19.79,4.62L14.03,12H14Z</Geometry>
        <Geometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="StarIcon">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Geometry>
        <Geometry x:Key="UserIcon">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</Geometry>
        <Geometry x:Key="InfoIcon">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</Geometry>
        <Geometry x:Key="ChatIcon">M12,3C17.5,3 22,6.58 22,11C22,15.42 17.5,19 12,19C10.76,19 9.57,18.82 8.47,18.5C5.55,21 2,21 2,21C4.33,18.67 4.7,17.1 4.75,16.5C3.05,15.07 2,13.13 2,11C2,6.58 6.5,3 12,3Z</Geometry>
        <Geometry x:Key="WarningIcon">M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16</Geometry>

        <!-- DataTemplate для отображения бронирований -->
        <DataTemplate x:Key="BookingTemplate">
            <Border Style="{StaticResource BookingCardStyle}" 
                    Tag="{Binding BookingID}"
                    MouseLeftButtonUp="BookingCard_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Дата -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StartDateTime, Converter={StaticResource DateTimeToShortDateConverter}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding StartDateTime, StringFormat='MMM yyyy'}"
                                   FontSize="12"
                                   Foreground="#666666"
                                   TextAlignment="Center"/>
                        <!--TextTransform="UpperCase"/>-->
                    </StackPanel>

                    <!-- Информация о друге и цели -->
                    <StackPanel Grid.Column="1" 
                                Margin="20,0,0,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="32"
                                    Height="32"
                                    Background="#E8F5E8"
                                    CornerRadius="16"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding FriendInitials}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#4CAF50"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding FriendName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"/>
                                <TextBlock Text="{Binding FriendCity}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Purpose}"
                                   FontSize="12"
                                   Foreground="#666666"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"/>
                        <TextBlock Text="{Binding MeetingLocation}"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Время -->
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StartDateTime, StringFormat='HH:mm'}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"/>
                        <TextBlock Text="до"
                                   FontSize="11"
                                   Foreground="#999999"/>
                        <TextBlock Text="{Binding EndDateTime, StringFormat='HH:mm'}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"/>
                    </StackPanel>

                    <!-- Длительность -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Duration, Converter={StaticResource TimeSpanToDurationConverter}}"
                               FontSize="14"
                               Foreground="#333333"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Сумма -->
                    <StackPanel Grid.Column="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"/>
                        <TextBlock Text="{Binding PaymentStatusDisplay}"
                                   FontSize="11"
                                   Foreground="{Binding PaymentStatusColor}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Статус -->
                    <Border Grid.Column="5"
                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StatusForegroundColor}"/>
                    </Border>

                    <!-- Действия -->
                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <!-- Кнопка деталей -->
                        <Button Style="{StaticResource SmallIconButton}"
                                Tag="{Binding BookingID}"
                                Click="BtnDetails_Click"
                                ToolTip="Посмотреть детали"
                                Margin="0,0,5,0">
                            <Path Data="{StaticResource InfoIcon}"
                                  Fill="#666666"
                                  Width="24"
                                  Height="24"/>
                        </Button>

                        <!-- Кнопка чата (если есть друг) -->
                        <Button x:Name="BtnChat" 
                                Style="{StaticResource SmallIconButton}"
                                Tag="{Binding FriendProfileID}"
                                Click="BtnChat_Click"
                                ToolTip="Написать сообщение"
                                Margin="0,0,5,0"
                                Visibility="{Binding CanChat, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource ChatIcon}"
                                  Fill="#666666"
                                  Width="24"
                                  Height="24"/>
                        </Button>

                        <!-- Кнопка отмены (только для активных бронирований) -->
                        <Button x:Name="BtnCancel" 
                                Style="{StaticResource SmallIconButton}"
                                Tag="{Binding BookingID}"
                                Click="BtnCancel_Click"
                                ToolTip="Отменить бронирование"
                                Margin="0,0,5,0"
                                Visibility="{Binding CanBeCancelled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource WarningIcon}"
                                  Fill="#FF5252"
                                  Width="24"
                                  Height="24"/>
                        </Button>

                        <!-- Кнопка отзыва (только для завершенных) -->
                        <Button x:Name="BtnReview" 
                                Style="{StaticResource SmallIconButton}"
                                Tag="{Binding BookingID}"
                                Click="BtnReview_Click"
                                ToolTip="Оставить отзыв"
                                Visibility="{Binding CanReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource StarIcon}"
                                  Fill="#4CAF50"
                                  Width="24"
                                  Height="24"/>
                        </Button>

                        <!-- Кнопка оплаты (если не оплачено) -->
                        <Button x:Name="BtnPay" 
                                Style="{StaticResource PrimaryButton}"
                                Tag="{Binding BookingID}"
                                Click="BtnPay_Click"
                                Content="Оплатить"
                                FontSize="12"
                                Width="80"
                                Height="28"
                                Margin="5,0,0,0"
                                Visibility="{Binding CanPay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Анимация загрузки -->
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingSpinner"
                             Storyboard.TargetProperty="RenderTransform.Angle"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Индикатор загрузки -->
        <Border x:Name="LoadingOverlay"
                Background="#F8F9FA"
                Opacity="0.9"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <Border Width="50" 
                        Height="50" 
                        CornerRadius="25"
                        Background="#4CAF50"
                        HorizontalAlignment="Center">
                    <Path x:Name="LoadingSpinner"
                          Data="{StaticResource RefreshIcon}"
                          Fill="White"
                          Width="24"
                          Height="24"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Border>
                <TextBlock Text="Загрузка..."
                           Margin="0,15,0,0"
                           FontSize="14"
                           Foreground="#666666"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Visible">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Text="📋 Мои бронирования"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"/>
                        <TextBlock x:Name="BookingsCountText"
                                   Text=" (0)"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"/>
                    </StackPanel>

                    <!-- Фильтры и поиск -->
                    <Border Grid.Row="1" 
                            Style="{StaticResource FilterCardStyle}"
                            Margin="0,0,0,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Фильтр по статусу -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="{StaticResource FilterIcon}"
                                          Fill="#4CAF50"
                                          Width="24"
                                          Height="24"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Статус"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#333333"/>
                                </StackPanel>

                                <WrapPanel>
                                    <Button x:Name="BtnFilterAll"
                                            VerticalAlignment="Center"
                                            Height="20"
                                            Content=" Все "
                                            Style="{StaticResource FilterButtonStyle}"
                                            Tag="Active"
                                            Click="FilterButton_Click"
                                            Margin="0,0,10,0"/>
                                    <Button x:Name="BtnFilterPending"
                                            Content=" Ожидают "
                                            Style="{StaticResource FilterButtonStyle}"
                                            Tag=""
                                            VerticalAlignment="Center"
                                            Height="20"
                                            Click="FilterButton_Click"
                                            Margin="0,0,10,0"/>
                                    <Button x:Name="BtnFilterConfirmed"
                                            Content=" Подтверждены "
                                            Style="{StaticResource FilterButtonStyle}"
                                            Tag=""
                                            VerticalAlignment="Center"
                                            Height="20"
                                            Click="FilterButton_Click"
                                            Margin="0,0,10,0"/>
                                    <Button x:Name="BtnFilterCompleted"
                                            Content=" Завершены "
                                            Style="{StaticResource FilterButtonStyle}"
                                            Tag=""
                                            VerticalAlignment="Center"
                                            Height="20"
                                            Click="FilterButton_Click"
                                            Margin="0,0,10,0"/>
                                    <Button x:Name="BtnFilterCancelled"
                                            Content=" Отменены "
                                            Style="{StaticResource FilterButtonStyle}"
                                            Tag=""
                                            VerticalAlignment="Center"
                                            Height="20"
                                            Click="FilterButton_Click"
                                            Margin="0,0,0,0"/>
                                    <Label Width="0.001"
                                        Margin="0,0,0,20"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Поиск -->
                            <Grid Grid.Column="1" Margin="0,0,20,0">

                                <Grid Margin="10" VerticalAlignment="Center">
                                    <Border Background="white"
                                            CornerRadius="8"
                                            Padding="5"
                                            BorderBrush="#4CAF50"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" x:Name="SearchTextBox"
                                                 Margin="0,0,10,0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="14"
                                                 Foreground="#333333"
                                                 TextChanged="SearchTextBox_TextChanged"
                                                 Tag="Поиск по друзьям, целям, локациям..."
                                                 GotFocus="SearchTextBox_GotFocus"
                                                 LostFocus="SearchTextBox_LostFocus">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <Button Grid.Column="1"
                                                    Content="Очистить"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Width="80"
                                                    HorizontalAlignment="Right"
                                                    Click="BtnClearSearch_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Кнопки управления -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="BtnRefresh"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="40"
                                        Height="40"
                                        Click="BtnRefresh_Click"
                                        ToolTip="Обновить список">
                                    <Path Data="{StaticResource RefreshIcon}"
                                          Fill="#4CAF50"
                                          Width="24"
                                          Height="24"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Статистика -->
                    <Grid Grid.Row="2" Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Карточка: Всего бронирований -->
                        <Border Style="{StaticResource StatsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#E8F5E8"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource CalendarIcon}"
                                              Fill="#4CAF50"
                                              Width="20"
                                              Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Всего встреч"
                                                   FontSize="12"
                                                   Foreground="#666666"/>
                                        <TextBlock x:Name="TotalBookingsText"
                                                   Text="{Binding TotalBookings}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#333333"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карточка: Активные -->
                        <Border Grid.Column="2" Style="{StaticResource StatsCardStyle}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#E8F5E8"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource ClockIcon}"
                                              Fill="#4CAF50"
                                              Width="20"
                                              Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Активные"
                                                   FontSize="12"
                                                   Foreground="#666666"/>
                                        <TextBlock x:Name="ActiveBookingsText"
                                                   Text="{Binding ActiveBookings}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#4CAF50"/>
                                    </StackPanel>
                                </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Карточка: Потрачено -->
                    <Border Grid.Column="4" Style="{StaticResource StatsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#E8F5E8"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource MoneyIcon}"
                                          Fill="#4CAF50"
                                          Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Всего потрачено"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                    <TextBlock x:Name="TotalSpentText"
                                               Text="0 ₽"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#333333"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Карточка: Средний чек -->
                    <Border Grid.Column="6" Style="{StaticResource StatsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#E8F5E8"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource MoneyIcon}"
                                          Fill="#4CAF50"
                                          Width="20"
                                          Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Средний чек"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                    <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AverageCheckText"
                                               Text="{Binding AverageCheck}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#333333"/>
                                    <TextBlock
                                               Text=" ₽"                                              FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#333333"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Список бронирований -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовки таблицы -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Style="{StaticResource StatsCardStyle}"
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock HorizontalAlignment="Center"
                                       Text="Дата"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"/>

                            <TextBlock HorizontalAlignment="Center"
                                       Grid.Column="1"
                                       Text="Друг / Цель"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"/>

                            <TextBlock Grid.Column="2"
                                       Text="Время"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="Длительность"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="4"
                                       Text="Сумма"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="5"
                                       Text="Статус"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="6"
                                       Text="Действия"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Список бронирований -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Style="{StaticResource StatsCardStyle}">
                        <Grid>
                            <!-- Сообщение о пустом списке -->
                            <Border x:Name="EmptyState"
                                    Visibility="Visible"
                                    Padding="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="80" 
                                            Height="80" 
                                            CornerRadius="40"
                                            Background="#F5F5F5"
                                            Margin="0,0,0,20">
                                        <Path Data="{StaticResource CalendarIcon}"
                                              Fill="#CCCCCC"
                                              Width="40"
                                              Height="40"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="У вас пока нет бронирований"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Найдите друзей и забронируйте встречу!"
                                               FontSize="14"
                                               Foreground="#999999"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,0"/>
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Найти друзей"
                                            Margin="0,20,0,0"
                                            Width="160"
                                            Click="BtnFindFriends_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Список бронирований -->
                            <ItemsControl x:Name="BookingsItemsControl"
                                            ItemsSource="{Binding Bookings}"
                                            ItemTemplate="{StaticResource BookingTemplate}"
                                            Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>