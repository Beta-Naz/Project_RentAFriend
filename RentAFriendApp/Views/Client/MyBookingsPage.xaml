<Page x:Class="RentAFriendApp.Views.Client.MyBookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RentAFriendApp.Views.Client"
      xmlns:converters="clr-namespace:RentAFriendApp.Converters.Client.MyBooking"
      xmlns:controls="clr-namespace:RentAFriendApp.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Мои бронирования"
      Background="#F8F9FA"
      Loaded="Page_Loaded">

    <Page.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:StatusToTextConverter x:Key="StatusToText"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:DateTimeToDateConverter x:Key="DateToDate"/>
        <converters:TimeSpanToTimeConverter x:Key="TimeToTime"/>
        <converters:PaymentStatusToColorConverter x:Key="PaymentToColor"/>
        <converters:PaymentStatusToTextConverter x:Key="PaymentToText"/>
        <converters:DurationToStringConverter x:Key="DurationToString"/>

        <!-- ===== СТИЛИ ===== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <Grid>
                                <!-- Иконка поиска -->
                                <TextBlock Text="🔍" 
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Visibility="Collapsed"
                                   x:Name="SearchIcon"/>

                                <!-- Текст -->
                                <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>

                                <!-- Placeholder -->
                                <TextBlock x:Name="Placeholder"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="#999999"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="Visible">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonActive" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ИКОНКИ ===== -->
        <Geometry x:Key="IconCalendar">M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z</Geometry>
        <Geometry x:Key="IconClock">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="IconMoney">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,17V16H9V14H13V13H10A2,2 0 0,1 8,11V9A2,2 0 0,1 10,7H11V6H13V7H15V9H11V10H14A2,2 0 0,1 16,12V14A2,2 0 0,1 14,16H13V17H11Z</Geometry>
        <Geometry x:Key="IconChat">M12,3C17.5,3 22,6.58 22,11C22,15.42 17.5,19 12,19C10.76,19 9.57,18.82 8.47,18.5C5.55,21 2,21 2,21C4.33,18.67 4.7,17.1 4.75,16.5C3.05,15.07 2,13.13 2,11C2,6.58 6.5,3 12,3Z</Geometry>
        <Geometry x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Geometry>
        <Geometry x:Key="IconCancel">M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z</Geometry>
        <Geometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
    </Page.Resources>

    <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <StackPanel>
                <!-- Заголовок -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="📋 Мои бронирования" FontSize="24" FontWeight="SemiBold" Foreground="#333333"/>
                    <TextBlock Text="{Binding BookingsCountText}" FontSize="24" FontWeight="Bold"
                               Foreground="#4CAF50" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- СТАТИСТИКА -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Всего -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#E8F5E8">
                                <Path Data="{StaticResource IconCalendar}" Fill="#4CAF50"
                                      Width="22" Height="22" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Всего" FontSize="11" Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalBookings}" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Активные -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#E8F5E8">
                                <Path Data="{StaticResource IconClock}" Fill="#4CAF50"
                                      Width="22" Height="22" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Активные" FontSize="11" Foreground="#666666"/>
                                <TextBlock Text="{Binding ActiveBookings}" FontSize="22" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Потрачено -->
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#E8F5E8">
                                <Path Data="{StaticResource IconMoney}" Fill="#4CAF50"
                                      Width="22" Height="22" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Потрачено" FontSize="11" Foreground="#666666"/>
                                <TextBlock Text="{Binding TotalSpent, StringFormat={}{0:N0} ₽}"
                                           FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Средний чек -->
                    <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#E8F5E8">
                                <Path Data="{StaticResource IconMoney}" Fill="#4CAF50"
                                      Width="22" Height="22" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Средний чек" FontSize="11" Foreground="#666666"/>
                                <TextBlock Text="{Binding AverageCheck, StringFormat={}{0:N0} ₽}"
                                           FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Фильтры -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Все" Style="{StaticResource FilterButtonActive}"
                                    Click="FilterButton_Click" Tag="All" Margin="0,0,8,0"/>
                            <Button Content="Ожидают" Style="{StaticResource FilterButton}"
                                    Click="FilterButton_Click" Tag="Pending" Margin="0,0,8,0"/>
                            <Button Content="Подтверждены" Style="{StaticResource FilterButton}"
                                    Click="FilterButton_Click" Tag="Confirmed" Margin="0,0,8,0"/>
                            <Button Content="Завершены" Style="{StaticResource FilterButton}"
                                    Click="FilterButton_Click" Tag="Completed" Margin="0,0,8,0"/>
                            <Button Content="Отменены" Style="{StaticResource FilterButton}"
                                    Click="FilterButton_Click" Tag="Cancelled"/>
                        </StackPanel>

                        <!-- Поиск -->
                        <TextBox Grid.Column="1"
                                 x:Name="SearchTextBox"
                                 Margin="20,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 TextChanged="SearchTextBox_TextChanged"/>

                        <!-- Обновить -->
                        <Button Grid.Column="2" Content="🔄" Style="{StaticResource PrimaryButton}"
                                Width="44" Click="BtnRefresh_Click" ToolTip="Обновить"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <!-- Пусто -->
                    <StackPanel>

                    <Border x:Name="EmptyState" Padding="40" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="У вас пока нет бронирований" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#666666" HorizontalAlignment="Center"/>
                            <Button Content="Найти друзей" Style="{StaticResource PrimaryButton}"
                                    Width="160" Margin="0,16,0,0" Click="BtnFindFriends_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Список -->
                        <ItemsControl ItemsSource="{Binding FilteredBookings}"
              Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MyBookingCard 
                                            DataContext="{Binding}"
                                            ChatClicked="BookingCard_ChatClicked"
                                            CancelClicked="BookingCard_CancelClicked"
                                            ReviewClicked="BookingCard_ReviewClicked"
                                            PayClicked="BookingCard_PayClicked"
                                            CardSelected="BookingCard_CardSelected"
                                            CardDoubleClicked="BookingCard_CardDoubleClicked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>