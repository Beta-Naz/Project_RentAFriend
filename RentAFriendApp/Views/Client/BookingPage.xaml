<Page x:Class="RentAFriendApp.Views.Client.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RentAFriendApp.Views.Client"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      xmlns:converters="clr-namespace:RentAFriendApp.Converters" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Бронирование встречи"
      Background="#F8F9FA"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- Конвертер для форматирования времени -->
        <converters:TimeSpanToShortTimeConverter x:Key="TimeSpanToShortTimeConverter"/>
        <converters:DateTimeToDisplayConverter x:Key="DateTimeToDisplayConverter"/>

        <!-- Стили для анимаций -->
        <Style x:Key="FadeInAnimation" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.01"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стили для карточек -->
        <Style x:Key="StatsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.02" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.02" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeSlotCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.03" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.03" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для выбранного временного слота -->
        <Style x:Key="SelectedTimeSlotStyle" TargetType="Border" BasedOn="{StaticResource TimeSlotCardStyle}">
            <Setter Property="Background" Value="#E8F5E8"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.1" ShadowDepth="0" Color="#4CAF50"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.03" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.03" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F5E8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#388E3C"/>
                                <Setter Property="Foreground" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для disabled кнопок -->
        <Style x:Key="DisabledButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Иконки -->
        <Geometry x:Key="CalendarIcon">M9,1V3H15V1H17V3H21C22.11,3 23,3.89 23,5V21C23,22.11 22.11,23 21,23H3C1.89,23 1,22.11 1,21V5C1,3.89 1.89,3 3,3H7V1H9M7,7V9H9V7H7M11,7V9H13V7H11M15,7V9H17V7H15M19,7V9H21V7H19M3,10V21H21V10H3Z</Geometry>
        <Geometry x:Key="ClockIcon">M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="MoneyIcon">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4M12,6C9.79,6 8,7.79 8,10C8,12.21 9.79,14 12,14C14.21,14 16,12.21 16,10C16,7.79 14.21,6 12,6M12,8C13.1,8 14,8.9 14,10C14,11.1 13.1,12 12,12C10.9,12 10,11.1 10,10C10,8.9 10.9,8 12,8Z</Geometry>
        <Geometry x:Key="StarIcon">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Geometry>
        <Geometry x:Key="LocationIcon">M12,2C8.13,2 5,5.13 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9C19,5.13 15.87,2 12,2ZM12,11.5C10.62,11.5 9.5,10.38 9.5,9C9.5,7.62 10.62,6.5 12,6.5C13.38,6.5 14.5,7.62 14.5,9C14.5,10.38 13.38,11.5 12,11.5Z</Geometry>
        <Geometry x:Key="ArrowBackIcon">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</Geometry>
        <Geometry x:Key="CheckIcon">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z</Geometry>
        <Geometry x:Key="PersonIcon">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</Geometry>
        <Geometry x:Key="InfoIcon">M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</Geometry>
        <Geometry x:Key="VerifiedIcon">M23,12L20.56,9.22L20.9,5.54L17.29,4.72L15.4,1.54L12,3L8.6,1.54L6.71,4.72L3.1,5.53L3.44,9.21L1,12L3.44,14.78L3.1,18.47L6.71,19.29L8.6,22.47L12,21L15.4,22.46L17.29,19.28L20.9,18.46L20.56,14.78L23,12M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z</Geometry>

        <!-- Анимация загрузки -->
        <Style x:Key="LoadingAnimation" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <!-- Индикатор загрузки -->
        <Border x:Name="LoadingOverlay" 
                Style="{StaticResource LoadingAnimation}"
                Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="50" 
                        Height="50" 
                        CornerRadius="25"
                        Background="#4CAF50"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                     From="0" To="360" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Path Data="M12,4V2A10,10 0 0,1 22,12H20A8,8 0 0,0 12,4Z"
                          Fill="White"
                          Stretch="Uniform"
                          Margin="12"/>
                </Border>
                <TextBlock Text="Загрузка..." 
                           Foreground="White"
                           FontSize="14"
                           Margin="0,15,0,0"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <Grid Margin="20">
                <!-- Заголовок и навигация -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Навигация назад -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Style="{StaticResource SecondaryButton}" 
                                Padding="10,0"
                                Click="BtnBack_Click"
                                ToolTip="Вернуться к каталогу друзей">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ArrowBackIcon}"
                                      Fill="#4CAF50"
                                      Width="24"
                                      Height="24"
                                      Margin="0,0,8,0"
                                      
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Назад"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock VerticalAlignment="Center"
                                   Text="📅 Бронирование встречи с "
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"/>
                        <TextBlock VerticalAlignment="Center"
                                   x:Name="FriendNameText"
                                   Text="Загрузка..."
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"/>
                        <Border x:Name="VerifiedBadge"
                                Background="#4CAF50"
                                CornerRadius="10"
                                Padding="8,4"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource VerifiedIcon}"
                                      Fill="White"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Проверен"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Основной контент -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: Форма бронирования -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <!-- Информация о друге -->
                            <Border Style="{StaticResource InfoCardStyle}" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Аватар с инициалами -->
                                    <Border Width="80"
                                            Height="80"
                                            Background="#E8F5E8"
                                            CornerRadius="40"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="AvatarInitials"
                                                   Text="??"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#4CAF50"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Информация о друге -->
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FriendFullName"
                                                       Text="Загрузка..."
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <!-- Рейтинг -->
                                            <Path Data="{StaticResource StarIcon}"
                                                  Fill="#FFC107"
                                                  Width="23"
                                                  Height="22"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RatingText"
                                                       Text="0.0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"
                                                       Margin="4,0,0,0"/>
                                            <TextBlock Text="•"
                                                       FontSize="14"
                                                       Foreground="#666666"
                                                       Margin="8,0,8,0"/>

                                            <!-- Ставка -->
                                            <Path Data="{StaticResource MoneyIcon}"
                                                  Fill="#666666"
                                                  Width="24"
                                                  Height="24"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HourlyRateDisplay"
                                                       VerticalAlignment="Center"
                                                       Text="0 ₽/час"
                                                       FontSize="14"
                                                       Foreground="#666666"
                                                       Margin="4,0,0,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="•"
                                                       FontSize="14"
                                                       Foreground="#666666"
                                                       Margin="8,0,8,0"/>

                                            <!-- Город -->
                                            <Path Data="{StaticResource LocationIcon}"
                                                  Fill="#666666"
                                                  Width="24"
                                                  Height="24"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CityText"
                                                       VerticalAlignment="Center"
                                                       Text="Не указан"
                                                       FontSize="14"
                                                       Foreground="#666666"
                                                       Margin="4,0,0,0"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="•"
                                                       FontSize="14"
                                                       Foreground="#666666"
                                                       Margin="8,0,8,0"/>

                                            <!-- Возраст -->
                                            <Path Data="{StaticResource PersonIcon}"
                                                  Fill="#666666"
                                                  Width="24"
                                                  Height="24"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AgeText"
                                                       VerticalAlignment="Center"
                                                       Text="Возраст не указан"
                                                       FontSize="14"
                                                       Foreground="#666666"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>

                                        <!-- Биография -->
                                        <TextBlock x:Name="BioText"
                                                   Text="Загрузка описания..."
                                                   FontSize="13"
                                                   Foreground="#666666"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>

                                        <!-- Хобби -->
                                        <StackPanel x:Name="HobbiesPanel" 
                                                    Orientation="Horizontal" 
                                                    Margin="0,12,0,0">
                                            <TextBlock Text="Хобби: "
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#333333"/>
                                            <TextBlock x:Name="HobbiesText"
                                                       Text="Не указаны"
                                                       FontSize="13"
                                                       Foreground="#666666"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Выбор даты и времени -->
                            <Border Style="{StaticResource InfoCardStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Path Data="{StaticResource CalendarIcon}"
                                              Fill="#4CAF50"
                                              Width="24"
                                              Height="24"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="🗓️ Выберите дату и время"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>
                                    </StackPanel>

                                    <!-- Календарь -->
                                    <StackPanel Margin="0,0,0,25">
                                        <TextBlock Text="Дата встречи"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#333333"
                                                   Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource SecondaryButton}" 
                                                    Width="40"
                                                    Height="40"
                                                    Content="‹"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Click="BtnPrevDate_Click"
                                                    ToolTip="Предыдущий день"/>

                                            <Border Grid.Column="1"
                                                    Background="#F5F5F5"
                                                    CornerRadius="8"
                                                    Height="40"
                                                    Margin="10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="SelectedDateText"
                                                           Text="Загрузка даты..."
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="#333333"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="40"
                                                    Height="40"
                                                    Content="›"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Click="BtnNextDate_Click"
                                                    ToolTip="Следующий день"/>
                                        </Grid>

                                        <!-- Индикатор сегодня/завтра -->
                                        <TextBlock x:Name="DateHintText"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="#4CAF50"
                                                   FontWeight="Medium"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Доступное время -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Data="{StaticResource ClockIcon}"
                                                  Fill="#4CAF50"
                                                  Width="24"
                                                  Height="24"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="🕐 Доступное время"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="#333333"/>
                                        </StackPanel>

                                        <WrapPanel x:Name="TimeSlotsPanel" 
                                                   Margin="0,0,0,15">
                                            <!-- Временные слоты будут добавляться динамически -->
                                        </WrapPanel>

                                        <!-- Сообщение при отсутствии слотов -->
                                        <Border x:Name="NoSlotsMessage"
                                                Background="#FFF8E1"
                                                CornerRadius="8"
                                                Padding="15"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource InfoIcon}"
                                                      Fill="#FFA000"
                                                      Width="20"
                                                      Height="20"
                                                      Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="На выбранную дату нет доступных слотов. Попробуйте выбрать другую дату."
                                                           FontSize="13"
                                                           Foreground="#333"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Выберите подходящий временной слот"
                                                   FontSize="12"
                                                   Foreground="#666666"
                                                   FontStyle="Italic"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Детали встречи -->
                            <Border Style="{StaticResource InfoCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="📝 Детали встречи"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#333333"
                                               Margin="0,0,0,20"/>

                                    <!-- Цель встречи -->
                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="Цель встречи *"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#333333"
                                                   Margin="0,0,0,10"/>
                                        <TextBox Padding="5,5,0,0"
                                                 x:Name="PurposeTextBox"
                                                 Height="80"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="Например: Прогулка в парке, поход в кино, обед в кафе"
                                                 FontSize="14"
                                                 Foreground="#666666"
                                                 GotFocus="PurposeTextBox_GotFocus"
                                                 LostFocus="PurposeTextBox_LostFocus"
                                                 TextChanged="PurposeTextBox_TextChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Padding" Value="12"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Border x:Name="border"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                                  Padding="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsFocused" Value="True">
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                                                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock x:Name="PurposeCounter"
                                                   Text="0/500"
                                                   FontSize="11"
                                                   Foreground="#999"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Место встречи -->
                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="Место встречи *"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#333333"
                                                   Margin="0,0,0,10"/>
                                        <TextBox Padding="5,0,0,0"
                                                 x:Name="LocationTextBox"
                                                 Height="40"
                                                 Text="Например: Парк Горького, главный вход"
                                                 FontSize="14"
                                                 Foreground="#666666"
                                                 GotFocus="LocationTextBox_GotFocus"
                                                 LostFocus="LocationTextBox_LostFocus"
                                                 TextChanged="LocationTextBox_TextChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Padding" Value="12"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Border x:Name="border"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                                  VerticalAlignment="Center"
                                                                                  Padding="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsFocused" Value="True">
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                                                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock x:Name="LocationCounter"
                                                   Text="0/255"
                                                   FontSize="11"
                                                   Foreground="#999"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Особые пожелания -->
                                    <StackPanel>
                                        <TextBlock Text="Особые пожелания (необязательно)"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#333333"
                                                   Margin="0,0,0,10"/>
                                        <TextBox Padding="5,5,0,0"
                                                 x:Name="SpecialRequestsTextBox"
                                                 Height="60"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontSize="14"
                                                 Foreground="#666666"
                                                 Text="Например: У меня аллергия на кошек, предпочитаю тихие места"
                                                 GotFocus="SpecialRequestsTextBox_GotFocus"
                                                 LostFocus="SpecialRequestsTextBox_LostFocus"
                                                 TextChanged="SpecialRequestsTextBox_TextChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Padding" Value="12"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Border x:Name="border"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4">
                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                                  Padding="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsFocused" Value="True">
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                                                                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock x:Name="SpecialRequestsCounter"
                                                   Text="0/1000"
                                                   FontSize="11"
                                                   Foreground="#999"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Правая колонка: Итоги и подтверждение -->
                        <StackPanel Grid.Column="1">
                            <!-- Итоговая информация -->
                            <Border Style="{StaticResource InfoCardStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <Path Data="{StaticResource MoneyIcon}"
                                              Fill="#4CAF50"
                                              Width="24"
                                              Height="24"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="🧾 Итог бронирования"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>
                                    </StackPanel>

                                    <!-- Детали заказа -->
                                    <StackPanel>
                                        <!-- Выбранное время -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Дата и время"
                                                       FontSize="14"
                                                       Foreground="#666666"/>
                                            <TextBlock Grid.Column="1"
                                                       x:Name="SelectedDateTimeText"
                                                       Text="Не выбрано"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="#333333"/>
                                        </Grid>

                                        <!-- Длительность -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Длительность"
                                                       FontSize="14"
                                                       Foreground="#666666"/>
                                            <TextBlock Grid.Column="1"
                                                       x:Name="DurationText"
                                                       Text="0 часов"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="#333333"/>
                                        </Grid>

                                        <!-- Ставка в час -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ставка в час"
                                                       FontSize="14"
                                                       Foreground="#666666"/>
                                            <TextBlock Grid.Column="1"
                                                       x:Name="HourlyRateText"
                                                       Text="0 ₽"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="#333333"/>
                                        </Grid>

                                        <!-- Разделитель -->
                                        <Border Height="1"
                                                Background="#E0E0E0"
                                                Margin="0,10,0,15"/>

                                        <!-- Итоговая сумма -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="Итого к оплате"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"/>
                                            <TextBlock Grid.Column="1"
                                                       x:Name="TotalAmountText"
                                                       Text="0 ₽"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#4CAF50"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Комиссия сервиса -->
                            <Border Style="{StaticResource InfoCardStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Data="{StaticResource InfoIcon}"
                                              Fill="#4CAF50"
                                              Width="24"
                                              Height="24"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Комиссия сервиса"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CommissionTextBlock"
                                               Text="В стоимость включена комиссия сервиса 15% (0 ₽). Оставшаяся сумма будет переведена другу после успешного завершения встречи."
                                               FontSize="12"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Условия бронирования -->
                            <Border Style="{StaticResource InfoCardStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="📋 Условия бронирования"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#333333"
                                               Margin="0,0,0,10"/>

                                    <StackPanel>
                                        <!-- Правило 1 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="20"
                                                    Height="20"
                                                    Background="#E8F5E8"
                                                    CornerRadius="10"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,8,0">
                                                <TextBlock Text="1"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#4CAF50"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Отмена возможна бесплатно за 24 часа до встречи"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Правило 2 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="20"
                                                    Height="20"
                                                    Background="#E8F5E8"
                                                    CornerRadius="10"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,8,0">
                                                <TextBlock Text="2"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#4CAF50"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="После подтверждения бронирования вы получите контактные данные друга"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Правило 3 -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="20"
                                                    Height="20"
                                                    Background="#E8F5E8"
                                                    CornerRadius="10"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,8,0">
                                                <TextBlock Text="3"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#4CAF50"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Оплата происходит онлайн при создании бронирования"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Кнопка подтверждения -->
                            <Border Style="{StaticResource InfoCardStyle}">
                                <StackPanel>
                                    <Button x:Name="BtnConfirmBooking"
                                            Style="{StaticResource DisabledButton}"
                                            Content="Подтвердить бронирование"
                                            Height="50"
                                            FontSize="16"
                                            Click="BtnConfirmBooking_Click"
                                            IsEnabled="False"
                                            ToolTip="Заполните все обязательные поля и выберите время">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Path Data="{StaticResource CheckIcon}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Width="20"
                                                          Height="20"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <TextBlock Text="Нажимая кнопку, вы соглашаетесь с условиями использования и политикой конфиденциальности"
                                               FontSize="11"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,15,0,0"/>

                                    <!-- Прогресс заполнения -->
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                        <Border Width="100"
                                                Height="4"
                                                Background="#E0E0E0"
                                                CornerRadius="2"
                                                VerticalAlignment="Center">
                                            <Border Width="0"
                                                    x:Name="ProgressBarFill"
                                                    Background="#4CAF50"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"/>
                                        </Border>
                                        <TextBlock Text="0%"
                                                   FontSize="11"
                                                   Foreground="#666"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>