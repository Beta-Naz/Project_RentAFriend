<Page x:Class="RentAFriendApp.Views.Client.ClientHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RentAFriendApp.Views.Client"
      xmlns:converters="clr-namespace:RentAFriendApp.Converters"
      xmlns:controls="clr-namespace:RentAFriendApp.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Главная - RentAFriend"
      Background="#F8F9FA"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <converters:InitialsConverter x:Key="InitialsConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Стили карточек -->
        <Style x:Key="StatsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BookingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль основной кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вторичной кнопки -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F9F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Геометрии иконок -->
        <Geometry x:Key="CalendarIcon">M9,1V3H15V1H17V3H21C22.11,3 23,3.89 23,5V21C23,22.11 22.11,23 21,23H3C1.89,23 1,22.11 1,21V5C1,3.89 1.89,3 3,3H7V1H9M7,7V9H9V7H7M11,7V9H13V7H11M15,7V9H17V7H15M19,7V9H21V7H19M3,10V21H21V10H3Z</Geometry>
        <Geometry x:Key="MoneyIcon">M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4M12,6C9.79,6 8,7.79 8,10C8,12.21 9.79,14 12,14C14.21,14 16,12.21 16,10C16,7.79 14.21,6 12,6M12,8C13.1,8 14,8.9 14,10C14,11.1 13.1,12 12,12C10.9,12 10,11.1 10,10C10,8.9 10.9,8 12,8Z</Geometry>
        <Geometry x:Key="ClockIcon">M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="TrendingUpIcon">M16,6L18.29,8.29L13.41,13.17L9.41,9.17L2,16.59L3.41,18L9.41,12L13.41,16L19.71,9.71L22,12V6H16Z</Geometry>
        <Geometry x:Key="UsersIcon">M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z</Geometry>
        <Geometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== ПРИВЕТСТВИЕ И СТАТУС ===== -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="👋 Добро пожаловать, "
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#333333"/>
                <TextBlock Text="{Binding UserFirstName}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#4CAF50"/>
                <TextBlock Text="!"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#333333"/>
            </StackPanel>

            <!-- ===== БЫСТРАЯ СТАТИСТИКА ===== -->
            <Border Grid.Row="1" 
                    Style="{StaticResource StatsCardStyle}"
                    Margin="0,0,0,25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- В этом месяце -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="#E8F5E8"
                                Width="48"
                                Height="48"
                                CornerRadius="10">
                            <Path Data="{StaticResource TrendingUpIcon}"
                                  Fill="#4CAF50"
                                  Width="24"
                                  Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="В этом месяце"
                                       FontSize="12"
                                       Foreground="#666666"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#333333">
                                <Run Text="{Binding MonthlyCount, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="встреч"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== ЛЕВАЯ КОЛОНКА ===== -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">

                    <!-- Статистика -->
                    <TextBlock Text="📊 Подробная статистика"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Карточка: Встречи -->
                        <Border Style="{StaticResource StatsCardStyle}"
                                MouseDown="StatsCard_MouseDown"
                                MouseEnter="StatsCard_MouseEnter"
                                MouseLeave="StatsCard_MouseLeave"
                                Tag="bookings"
                                ToolTip="Нажмите для детальной статистики">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#E8F5E8"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="10">
                                        <Path Data="{StaticResource CalendarIcon}"
                                              Fill="#4CAF50"
                                              Width="24"
                                              Height="24"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Всего встреч"
                                                   FontSize="12"
                                                   Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TotalBookings}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="#333333"/>
                                            <TextBlock Text="{Binding BookingsTrend}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#4CAF50"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding ActiveBookings, StringFormat='Активных: {0}'}"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                    <TextBlock HorizontalAlignment="Right"
                                               Text="{Binding CompletedCount, StringFormat='Завершено: {0}'}"
                                               FontSize="12"
                                               Foreground="#666666"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Карточка: Финансы -->
                        <Border Grid.Column="2"
                                Style="{StaticResource StatsCardStyle}"
                                MouseDown="StatsCard_MouseDown"
                                MouseEnter="StatsCard_MouseEnter"
                                MouseLeave="StatsCard_MouseLeave"
                                Tag="spent"
                                ToolTip="Нажмите для финансовой статистики">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#E8F5E8"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="10">
                                        <Path Data="{StaticResource MoneyIcon}"
                                              Fill="#4CAF50"
                                              Width="24"
                                              Height="24"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Всего потрачено"
                                                   FontSize="12"
                                                   Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TotalSpent, StringFormat={}{0:N0} ₽}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="#333333"/>
                                            <TextBlock Text="{Binding SpentTrend}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#4CAF50"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding AverageCheck, StringFormat='Средний чек: {0:N0} ₽'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                            </StackPanel>
                        </Border>

                        <!-- Карточка: Время -->
                        <Border Grid.Column="4"
                                Style="{StaticResource StatsCardStyle}"
                                MouseDown="StatsCard_MouseDown"
                                MouseEnter="StatsCard_MouseEnter"
                                MouseLeave="StatsCard_MouseLeave"
                                Tag="hours"
                                ToolTip="Нажмите для статистики по времени">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#E8F5E8"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="10">
                                        <Path Data="{StaticResource ClockIcon}"
                                              Fill="#4CAF50"
                                              Width="24"
                                              Height="24"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Времени с друзьями"
                                                   FontSize="12"
                                                   Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TotalHours, StringFormat={}{0} ч}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="#333333"/>
                                            <TextBlock Text="{Binding HoursTrend}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#4CAF50"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding UniqueFriendsCount, StringFormat='Разных друзей: {0}'}"
                                           FontSize="12"
                                           Foreground="#666666"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Ближайшие встречи -->
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="📅 Ближайшие встречи"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding UpcomingBookings.Count, StringFormat='{}{0} предстоящих'}"
                                   FontSize="12"
                                   Foreground="#666666"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Style="{StaticResource StatsCardStyle}">
                        <StackPanel>
                            <!-- Заголовки -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock HorizontalAlignment="Center" Text="Дата" FontSize="12" FontWeight="SemiBold" Foreground="#666666"/>
                                <TextBlock HorizontalAlignment="Center" Grid.Column="1" Text="Друг / Цель" FontSize="12" FontWeight="SemiBold" Foreground="#666666"/>
                                <TextBlock HorizontalAlignment="Center" Grid.Column="2" Text="Время" FontSize="12" FontWeight="SemiBold" Foreground="#666666"/>
                                <TextBlock HorizontalAlignment="Center" Grid.Column="3" Text="Статус" FontSize="12" FontWeight="SemiBold" Foreground="#666666"/>
                                <TextBlock HorizontalAlignment="Center" Grid.Column="4" Text="" FontSize="12"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding UpcomingBookings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:BookingCard 
                                        DataContext="{Binding}"
                                        Margin="0,0,0,12"
                                        CardClicked="BookingCard_CardClicked"
                                        MenuClicked="BookingCard_MenuClicked"
                                        DoubleClicked="BookingCard_DoubleClicked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Нет встреч -->
                            <Border Background="#F8F9FA"
                                    CornerRadius="8"
                                    Padding="30"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding HasNoUpcomingBookings, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="У вас нет предстоящих встреч" FontSize="14" FontWeight="SemiBold" Foreground="#666666" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Найдите друзей и запланируйте встречу!" FontSize="12" Foreground="#999999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Кнопка "Все встречи" -->
                            <Button Content="Все мои встречи →"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,15,0,0"
                                    Command="{Binding NavigateToMyBookingsCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== ПРАВАЯ КОЛОНКА ===== -->
                <StackPanel Grid.Column="1">

                    <!-- Рекомендации -->
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="⭐ Персональные рекомендации"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Left"/>
                        <Button HorizontalAlignment="Right"
                                Width="36"
                                Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Обновить рекомендации"
                                Command="{Binding RefreshRecommendationsCommand}">
                            <Path Data="{StaticResource RefreshIcon}"
                                  Fill="#666666"
                                  Width="20"
                                  Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource StatsCardStyle}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding RecommendedFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FriendCardStyle}"
                                            Margin="0,0,0,12"
                                            MouseDown="FriendCard_MouseDown"
                                            Cursor="Hand">
                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Аватар -->
                                            <Border Width="56"
                                                    Height="56"
                                                    CornerRadius="28"
                                                    Background="#E8F5E8">
                                                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#4CAF50"/>
                                            </Border>

                                            <!-- Информация -->
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding FullName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding City}"
                                                           FontSize="12"
                                                           Foreground="#666666"/>
                                                <TextBlock Margin="0,2,0,0">
                                                    <Run Text="⭐"/>
                                                    <Run Text="{Binding AverageRating, StringFormat={}{0:F1}}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding HourlyRate, StringFormat={}{0:N0} ₽/ч}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Bio}"
                                                           FontSize="12"
                                                           Foreground="#666666"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="36"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Нет рекомендаций -->
                            <Border Background="#F8F9FA"
                                CornerRadius="8"
                                Padding="20"
                                Visibility="{Binding HasNoRecommendations, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⭐" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Загрузка рекомендаций..." FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                                    <ProgressBar IsIndeterminate="True" Height="4" Width="100" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Быстрые действия -->
                    <TextBlock Text="⚡ Быстрые действия"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,25,0,15"/>

                    <Border Style="{StaticResource StatsCardStyle}">
                        <StackPanel>
                            <Button Content="🔍 Найти друга"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,10"
                                    Command="{Binding NavigateToCatalogCommand}"/>

                            <Button Content="📅 Запланировать встречу"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,10"
                                    Command="{Binding NavigateToCatalogCommand}"/>

                            <Button Content="💬 Оставить отзыв"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,10"
                                    Command="{Binding NavigateToMyBookingsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Недавняя активность -->
                    <TextBlock Text="🕐 Недавняя активность"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,25,0,15"/>

                    <Border Style="{StaticResource StatsCardStyle}">
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="6"
                                                Background="#E8F5E8">
                                            <TextBlock Text="✓"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4CAF50"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="13"
                                                       Foreground="#333333"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                       FontSize="11"
                                                       Foreground="#999999"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>