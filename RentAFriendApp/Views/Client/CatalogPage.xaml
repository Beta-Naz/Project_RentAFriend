<Page x:Class="RentAFriendApp.Views.Client.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:convertes="clr-namespace:RentAFriendApp.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="Каталог друзей"
      Background="#F8F9FA">

    <Page.Resources>
        <convertes:InitialsConverter x:Key="InitialsConverter"/>
        <Style x:Key="ChipRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                        CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль карточки друга -->
        <Style x:Key="FriendCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль карточки фильтра -->
        <Style x:Key="FilterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для чипсов-фильтров -->
        <Style x:Key="ChipButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль поля поиска -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль основной кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Иконки -->
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поисковая строка -->
        <Border Grid.Row="0" Style="{StaticResource FilterCardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource SearchIcon}"
                      Fill="#666666"
                      Width="20" Height="20"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="🔍 Поиск по имени, городу или хобби"/>

                <Button Grid.Column="2" Content="Найти" 
                        Style="{StaticResource PrimaryButton}"
                        Width="100" Margin="12,0,0,0"
                        Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Фильтры -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>

                    <!-- Город -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel>
                            <TextBlock Text="📍 Город" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="#333333" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding AvailableCities}" 
                                      SelectedItem="{Binding SelectedCity}"
                                      Height="36" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Цена -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel>
                            <TextBlock Text="💰 Цена до" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="#333333" Margin="0,0,0,10"/>
                            <Slider Minimum="100" Maximum="10000" Value="{Binding MaxPrice}" 
                                    TickFrequency="500" IsSnapToTickEnabled="True"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="0 ₽" FontSize="12" Foreground="#666666" 
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding MaxPrice, StringFormat={}{0:N0} ₽}" 
                                           FontSize="13" FontWeight="SemiBold" Foreground="#4CAF50" 
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Рейтинг -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel>
                            <TextBlock Text="⭐ Рейтинг" FontSize="15" FontWeight="SemiBold" 
                   Foreground="#333333" Margin="0,0,0,10"/>
                            <RadioButton Content="★★★★★ от 4.5" Style="{StaticResource ChipRadioButton}" 
                      Margin="0,0,0,6" GroupName="Rating"
                      IsChecked="{Binding Rating45}"/>
                            <RadioButton Content="★★★★☆ от 4.0" Style="{StaticResource ChipRadioButton}" 
                      Margin="0,0,0,6" GroupName="Rating"
                      IsChecked="{Binding Rating40}"/>
                            <RadioButton Content="★★★☆☆ от 3.0" Style="{StaticResource ChipRadioButton}" 
                      Margin="0,0,0,6" GroupName="Rating"
                      IsChecked="{Binding Rating30}"/>
                            <RadioButton Content="Любой рейтинг" Style="{StaticResource ChipRadioButton}" 
                      GroupName="Rating"
                      IsChecked="{Binding RatingAny}"/>
                        </StackPanel>
                    </Border>

                    <!-- Верификация -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel>
                            <TextBlock Text="✅ Верификация" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="#333333" Margin="0,0,0,10"/>
                            <CheckBox Content="Только проверенные" IsChecked="{Binding OnlyVerified}" 
                                      FontSize="13" Foreground="#333333"/>
                        </StackPanel>
                    </Border>

                    <!-- Хобби -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel>
                            <TextBlock Text="🎯 Хобби" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="#333333" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <ToggleButton Content="Спорт" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Спорт"/>
                                <ToggleButton Content="Кино" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Кино"/>
                                <ToggleButton Content="Музыка" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Музыка"/>
                                <ToggleButton Content="Путешествия" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Путешествия"/>
                                <ToggleButton Content="Искусство" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Искусство"/>
                                <ToggleButton Content="Фотография" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Фотография"/>
                                <ToggleButton Content="Кулинария" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Кулинария"/>
                                <ToggleButton Content="Театр" Style="{StaticResource ChipButton}" 
                                              Margin="0,0,6,6" Command="{Binding ToggleHobbyCommand}" CommandParameter="Театр"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопка сброса -->
                    <Button Content="🔄 Сбросить фильтры" 
                            Background="Transparent" BorderBrush="#E0E0E0" 
                            BorderThickness="1" Foreground="#757575" 
                            FontSize="13" Height="40"
                            Cursor="Hand" Click="ResetButton_Click" Margin="0,8,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Правая панель: Список друзей -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel x:Name="FriendsPanel"/>

                    <Border x:Name="NoResultsPanel" Visibility="Collapsed" 
             Background="White" CornerRadius="12" Padding="40" Margin="0,20,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Ничего не найдено" FontSize="18" FontWeight="SemiBold" 
                        Foreground="#333333" HorizontalAlignment="Center"/>
                            <TextBlock Text="Попробуйте изменить фильтры" FontSize="13" 
                        Foreground="#666666" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Загрузка -->
                    <Border x:Name="LoadingPanel" Visibility="Collapsed" 
             HorizontalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                            <TextBlock Text="Загрузка..." FontSize="13" Foreground="#666666" 
                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>