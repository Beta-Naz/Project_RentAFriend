<Page x:Class="RentAFriendApp.Views.Client.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RentAFriendApp.Views.Client"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Каталог друзей - RentAFriend"
      Background="#F8F9FA"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <!-- Стили для карточек друзей -->
        <Style x:Key="FriendCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек фильтров -->
        <Style x:Key="FilterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для кнопок -->
        <Style x:Key="FilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F5E8"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ползунка цены -->
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="5000"/>
            <Setter Property="TickFrequency" Value="500"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <!-- Иконки -->
        <Geometry x:Key="FilterIcon">M14,12V19.88C14.04,20.18 13.94,20.5 13.71,20.71C13.32,21.1 12.69,21.1 12.3,20.71L10.29,18.7C10.06,18.47 9.96,18.16 10,17.87V12H9.97L4.21,4.62C3.87,4.19 3.95,3.56 4.38,3.22C4.57,3.08 4.78,3 5,3V3H19V3C19.22,3 19.43,3.08 19.62,3.22C20.05,3.56 20.13,4.19 19.79,4.62L14.03,12H14Z</Geometry>
        <Geometry x:Key="StarIcon">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Geometry>
        <Geometry x:Key="LocationIcon">M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z</Geometry>
        <Geometry x:Key="ClockIcon">M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="VerifiedIcon">M23,12L20.56,9.22L20.9,5.54L17.29,4.72L15.4,1.54L12,3L8.6,1.54L6.71,4.72L3.1,5.53L3.44,9.21L1,12L3.44,14.78L3.1,18.47L6.71,19.29L8.6,22.47L12,21L15.4,22.46L17.29,19.28L20.9,18.46L20.56,14.78L23,12M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z</Geometry>
        <Geometry x:Key="SortIcon">M3,13H15V11H3M3,6V8H21V6M3,18H9V16H3V18Z</Geometry>
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="BackIcon">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</Geometry>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с поиском и фильтрами -->
        <Border Grid.Row="0" 
                Background="White"
                Padding="20"
                Margin="0,0,0,20"
                CornerRadius="12"
                Style="{StaticResource FilterCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка возврата и заголовок -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Вернуться на главную"
                            Click="BackButton_Click">
                        <Path Data="{StaticResource BackIcon}"
                              Fill="#4CAF50"
                              Width="24"
                              Height="24"
                              Stretch="Uniform"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource FilterIcon}"
                              Fill="#4CAF50"
                              Width="24"
                              Height="24"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="Каталог друзей"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>
                    </StackPanel>
                </StackPanel>

                <!-- Поиск -->
                <Border Grid.Column="1" 
                        Background="#F5F5F5"
                        CornerRadius="20"
                        Padding="12,8"
                        Margin="20,0,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Path Data="{StaticResource SearchIcon}"
                              Fill="#999999"
                              Width="24"
                              Height="24"
                              VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="8,0,0,0"
                                 Foreground="#333333"
                                 Text="Найти друга по имени, хобби или городу..."
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 KeyDown="SearchTextBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button x:Name="SearchButton"
                                Grid.Column="2"
                                Content="Найти"
                                Background="#4CAF50"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Height="32"
                                Padding="16,0"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Сортировка -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сортировка:"
                               FontSize="13"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="SortComboBox"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              Width="160"
                              Height="36"
                              FontSize="13"
                              SelectedIndex="0"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="По рейтингу"/>
                        <ComboBoxItem Content="По цене (дешевле)"/>
                        <ComboBoxItem Content="По цене (дороже)"/>
                        <ComboBoxItem Content="По новизне"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Фильтры -->
            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,20,0"
                          ScrollChanged="FilterScrollViewer_ScrollChanged">
                <StackPanel x:Name="FilterPanel">
                    <!-- Фильтр по городу -->
                    <Border Style="{StaticResource FilterCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Data="{StaticResource LocationIcon}"
                                      Fill="#4CAF50"
                                      Width="24"
                                      Height="24"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Город"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"/>
                            </StackPanel>

                            <ComboBox x:Name="CityComboBox"
                                      Height="36"
                                      FontSize="13"
                                      SelectedIndex="0"
                                      SelectionChanged="CityComboBox_SelectionChanged"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="Все города"/>
                                <ComboBoxItem Content="Москва"/>
                                <ComboBoxItem Content="Санкт-Петербург"/>
                                <ComboBoxItem Content="Новосибирск"/>
                                <ComboBoxItem Content="Екатеринбург"/>
                                <ComboBoxItem Content="Казань"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Фильтр по цене -->
                    <Border Style="{StaticResource FilterCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Цена за час"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Slider x:Name="PriceSlider"
                                        Grid.Column="0"
                                        Style="{StaticResource SliderStyle}"
                                        Value="2500"
                                        ValueChanged="PriceSlider_ValueChanged"/>

                                <TextBlock x:Name="PriceValueText"
                                           Grid.Column="1"
                                           Text="2500 ₽"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#4CAF50"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="0 ₽"
                                           FontSize="12"
                                           Foreground="#666666"/>

                                <TextBlock Text="5000 ₽"
                                           Grid.Column="1"
                                           FontSize="12"
                                           Foreground="#666666"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Фильтр по рейтингу -->
                    <Border Style="{StaticResource FilterCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Data="{StaticResource StarIcon}"
                                      Fill="#FFC107"
                                      Width="24"
                                      Height="24"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Рейтинг"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"/>
                            </StackPanel>

                            <StackPanel>
                                <ToggleButton x:Name="Rating45Button"
                                              Content="★★★★★ (4.5+)"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,0,8"
                                              Checked="RatingButton_Checked"
                                              Unchecked="RatingButton_Unchecked"/>

                                <ToggleButton x:Name="Rating40Button"
                                              Content="★★★★☆ (4.0+)"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,0,8"
                                              Checked="RatingButton_Checked"
                                              Unchecked="RatingButton_Unchecked"/>

                                <ToggleButton x:Name="Rating35Button"
                                              Content="★★★☆☆ (3.5+)"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,0,8"
                                              Checked="RatingButton_Checked"
                                              Unchecked="RatingButton_Unchecked"/>

                                <ToggleButton x:Name="Rating30Button"
                                              Content="★★☆☆☆ (3.0+)"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Checked="RatingButton_Checked"
                                              Unchecked="RatingButton_Unchecked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Фильтр по верификации -->
                    <Border Style="{StaticResource FilterCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Data="{StaticResource VerifiedIcon}"
                                      Fill="#4CAF50"
                                      Width="24"
                                      Height="24"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Верификация"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"/>
                            </StackPanel>

                            <CheckBox x:Name="VerifiedCheckBox"
                                      Content="Только проверенные друзья"
                                      FontSize="13"
                                      Foreground="#333333"
                                      IsChecked="True"
                                      Checked="VerifiedCheckBox_Checked"
                                      Unchecked="VerifiedCheckBox_Unchecked"/>
                        </StackPanel>
                    </Border>

                    <!-- Фильтр по хобби -->
                    <Border Style="{StaticResource FilterCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Хобби и интересы"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,12"/>

                            <WrapPanel>
                                <ToggleButton x:Name="SportHobbyButton"
                                              Content="Спорт"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>

                                <ToggleButton x:Name="MovieHobbyButton"
                                              Content="Кино"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>

                                <ToggleButton x:Name="MusicHobbyButton"
                                              Content="Музыка"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>

                                <ToggleButton x:Name="TravelHobbyButton"
                                              Content="Путешествия"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>

                                <ToggleButton x:Name="ArtHobbyButton"
                                              Content="Искусство"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>

                                <ToggleButton x:Name="PhotoHobbyButton"
                                              Content="Фотография"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>

                                <ToggleButton x:Name="CookingHobbyButton"
                                              Content="Кулинария"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>

                                <ToggleButton x:Name="TheaterHobbyButton"
                                              Content="Театр"
                                              Style="{StaticResource FilterButtonStyle}"
                                              Margin="0,0,8,8"
                                              Checked="HobbyButton_Checked"
                                              Unchecked="HobbyButton_Unchecked"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Фильтр по доступности -->
                    <Border Style="{StaticResource FilterCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Data="{StaticResource ClockIcon}"
                                      Fill="#4CAF50"
                                      Width="24"
                                      Height="24"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Доступность"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"/>
                            </StackPanel>

                            <StackPanel>
                                <RadioButton x:Name="AnyTimeRadioButton"
                                             Content="Любое время"
                                             GroupName="Availability"
                                             FontSize="13"
                                             Foreground="#333333"
                                             IsChecked="True"
                                             Margin="0,0,0,8"
                                             Checked="AvailabilityRadioButton_Checked"/>

                                <RadioButton x:Name="TodayRadioButton"
                                             Content="Сегодня"
                                             GroupName="Availability"
                                             FontSize="13"
                                             Foreground="#333333"
                                             Margin="0,0,0,8"
                                             Checked="AvailabilityRadioButton_Checked"/>

                                <RadioButton x:Name="TomorrowRadioButton"
                                             Content="Завтра"
                                             GroupName="Availability"
                                             FontSize="13"
                                             Foreground="#333333"
                                             Margin="0,0,0,8"
                                             Checked="AvailabilityRadioButton_Checked"/>

                                <RadioButton x:Name="WeekendRadioButton"
                                             Content="На выходных"
                                             GroupName="Availability"
                                             FontSize="13"
                                             Foreground="#333333"
                                             Checked="AvailabilityRadioButton_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки фильтров -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ApplyFiltersButton"
                                Content="Применить фильтры"
                                Background="#4CAF50"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Height="44"
                                Cursor="Hand"
                                Click="ApplyFiltersButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="ResetFiltersButton"
                                Grid.Column="1"
                                Content="Сбросить"
                                Background="Transparent"
                                BorderBrush="#4CAF50"
                                BorderThickness="1"
                                Foreground="#4CAF50"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Height="44"
                                Margin="12,0,0,0"
                                Cursor="Hand"
                                Click="ResetFiltersButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Правая панель: Список друзей -->
            <ScrollViewer x:Name="FriendsScrollViewer"
                          Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="FriendsScrollViewer_ScrollChanged">
                <WrapPanel x:Name="FriendsPanel">
                    <!-- Карточки будут добавляться динамически -->
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>