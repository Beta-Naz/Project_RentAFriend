<Page x:Class="RentAFriendApp.Views.Client.FriendDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RentAFriendApp.Views.Client"
      xmlns:system="clr-namespace:System;assembly=mscorlib" 
      xmlns:converters="clr-namespace:RentAFriendApp.Converters" 
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Профиль друга - RentAFriend"
      Background="#F8F9FA"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeSlotStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F9F0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BookedTimeSlotStyle" TargetType="Border" BasedOn="{StaticResource TimeSlotStyle}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style x:Key="SelectedTimeSlotStyle" TargetType="Border" BasedOn="{StaticResource TimeSlotStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#388E3C"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <converters:DateAddConverter x:Key="DateAddConverter"/>
        <converters:InitialsConverter x:Key="InitialsConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:RatingToStarsConverterFigure x:Key="RatingToStarsConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Geometry x:Key="StarIcon">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Geometry>
        <Geometry x:Key="LocationIcon">M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z</Geometry>
        <Geometry x:Key="VerifiedIcon">M23,12L20.56,9.22L20.9,5.54L17.29,4.72L15.4,1.54L12,3L8.6,1.54L6.71,4.72L3.1,5.53L3.44,9.21L1,12L3.44,14.78L3.1,18.47L6.71,19.29L8.6,22.47L12,21L15.4,22.46L17.29,19.28L20.9,18.46L20.56,14.78L23,12M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z</Geometry>
        <Geometry x:Key="CalendarIcon">M9,1V3H15V1H17V3H21C22.11,3 23,3.89 23,5V21C23,22.11 22.11,23 21,23H3C1.89,23 1,22.11 1,21V5C1,3.89 1.89,3 3,3H7V1H9M7,7V9H9V7H7M11,7V9H13V7H11M15,7V9H17V7H15M19,7V9H21V7H19M3,10V21H21V10H3Z</Geometry>
        <Geometry x:Key="MessageIcon">M20,2H4C2.9,2 2,2.9 2,4V22L6,18H20C21.1,18 22,17.1 22,16V4C22,2.9 21.1,2 20,2Z</Geometry>
        <Geometry x:Key="ArrowBackIcon">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</Geometry>
        <Geometry x:Key="HeartIcon">M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z</Geometry>
        <Geometry x:Key="ShareIcon">M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19C20.92,17.39 19.61,16.08 18,16.08Z</Geometry>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ===== ЛЕВАЯ КОЛОНКА ===== -->
            <StackPanel Grid.Column="0" Margin="0,0,30,0">

                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Border Width="120" Height="120" Background="#E8F5E8" CornerRadius="60">
                                    <TextBlock x:Name="AvatarText" Text="{Binding FriendInitials}"
                                               FontSize="36" FontWeight="Bold" Foreground="#4CAF50"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="32" Height="32" Background="#4CAF50" CornerRadius="16"
                                        BorderBrush="White" BorderThickness="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="{Binding IsVerified, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{StaticResource VerifiedIcon}" Fill="White" Width="24" Height="24"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FriendName}" FontSize="24" FontWeight="Bold" Foreground="#333333"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Path Data="{StaticResource LocationIcon}" Fill="#666666" Width="24" Height="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FriendCity}" FontSize="14" Foreground="#666666" Margin="6,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource StarIcon}" Fill="#FFC107" Width="24" Height="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FriendRatingDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="#333333" Margin="4,0,4,0"/>
                                        <TextBlock Text="{Binding ReviewCountDisplay}" FontSize="13" Foreground="#666666"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding FriendRateDisplay}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Мои интересы:" FontSize="15" FontWeight="SemiBold" Foreground="#333333"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding FriendHobbies, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding FriendBio}" FontSize="14" Foreground="#666666"
                                   TextWrapping="Wrap" LineHeight="1.5" Margin="0,0,0,20"/>

                        <WrapPanel x:Name="HobbiesPanel" Margin="0,0,0,20"
                                   Visibility="{Binding FriendHobbies, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding TotalBookings}" FontSize="20" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                                <TextBlock Text="встречи" FontSize="12" Foreground="#666666" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="#E0E0E0" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="10,0,10,0">
                                <TextBlock Text="{Binding CompletedPercent}" FontSize="20" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                                <TextBlock Text="успешных" FontSize="12" Foreground="#666666" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="1" Background="#E0E0E0" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ReviewCount}" FontSize="20" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                                <TextBlock Text="отзывов" FontSize="12" Foreground="#666666" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MessageButton" Grid.Column="0"
                            Background="White" BorderBrush="#4CAF50" BorderThickness="1"
                            Foreground="#4CAF50" FontSize="14" FontWeight="SemiBold"
                            Height="48" Margin="0,0,10,0" Cursor="Hand" Click="MessageButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource MessageIcon}" Fill="#4CAF50" Width="24" Height="22" Margin="0,0,8,0"/>
                            <TextBlock Text="Написать сообщение"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BookButton" Grid.Column="1" Content="Забронировать"
                            Background="#4CAF50" Foreground="White" FontSize="14" FontWeight="SemiBold"
                            Height="48" Padding="24,0" Cursor="Hand" Click="BookButton_Click"/>
                </Grid>

                <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}"
                        Height="40" Width="40" Click="BackButton_Click" HorizontalAlignment="Left">
                    <Path Data="{StaticResource ArrowBackIcon}" Fill="#666666" Width="24" Height="24"/>
                </Button>
            </StackPanel>

            <!-- ===== ПРАВАЯ КОЛОНКА ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- ===== РАСПИСАНИЕ ===== -->
                <Border Style="{StaticResource InfoCardStyle}" Grid.Row="0">
                    <StackPanel>
                        <!-- Заголовок -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="{StaticResource CalendarIcon}" Fill="#4CAF50" Width="24" Height="24" 
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Расписание" FontSize="18" FontWeight="SemiBold" Foreground="#212121"/>
                            <TextBlock x:Name="SelectedDateLabel" Text="" FontSize="13" Foreground="#757575" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        </StackPanel>

                        <!-- Сетка дней недели -->
                        <Grid x:Name="WeekGrid" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <Border Height="1" Background="#E8ECF0" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Доступные слоты" FontSize="14" FontWeight="SemiBold" Foreground="#424242"/>
                            <TextBlock x:Name="SlotsSummaryText" Text="" FontSize="12" Foreground="#9E9E9E" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <WrapPanel x:Name="TimeSlotsPanel" Margin="0,0,0,14"/>

                        <Border x:Name="NoSlotsPanel" Visibility="Collapsed" 
                                Background="#F8F9FA" CornerRadius="10" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📅" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="NoSlotsMessageText" Text="Нет доступных слотов на этот день" 
                                           FontSize="14" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="NoSlotsHintText" Text="Выберите другую дату или свяжитесь с другом" 
                                           FontSize="12" Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SummaryPanel" Background="#E8F5E9" CornerRadius="10" Padding="14"
                                BorderBrush="#C8E6C9" BorderThickness="1" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SummaryTimeText" Text="Выбрано: 10:00 – 11:00" 
                                               FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    <TextBlock x:Name="SummaryDurationText" Text="1 час" 
                                               FontSize="12" Foreground="#66BB6A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Стоимость" FontSize="11" Foreground="#66BB6A" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="SummaryPriceText" Text="1 500 ₽" FontSize="20" FontWeight="Bold" 
                                               Foreground="#2E7D32" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Кнопки избранное/поделиться -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Height="40" Orientation="Horizontal">
                    <Button x:Name="ShareButton" Style="{StaticResource IconButtonStyle}" 
                            Height="40" Width="40" Click="ShareButton_Click">
                        <Path Data="{StaticResource ShareIcon}" Fill="#666666" Width="24" Height="22"/>
                    </Button>
                </StackPanel>

                <!-- ===== ОТЗЫВЫ ===== -->
                <Border Style="{StaticResource InfoCardStyle}" Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="{StaticResource StarIcon}" Fill="#FFC107" Width="24" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ReviewHeader}" FontSize="16" FontWeight="SemiBold" Foreground="#333333"/>
                        </StackPanel>

                        <ScrollViewer x:Name="ReviewsScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="400" ScrollChanged="ReviewsScrollViewer_ScrollChanged">
                            <ItemsControl x:Name="ReviewsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ReviewCardStyle}" MouseRightButtonDown="ReviewBorder_MouseRightButtonDown">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" Background="#E8F5E8" CornerRadius="20">
                                                        <TextBlock Text="{Binding ReviewerInitials}" FontSize="14" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ReviewerName}" FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <ItemsControl ItemsSource="{Binding Stars}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Path Data="{StaticResource StarIcon}" Fill="#FFC107" Width="24" Height="22"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="11" Foreground="#999999" Margin="12,0,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Comment}" FontSize="13" Foreground="#666666" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button x:Name="ViewAllReviewsButton" Content="Показать все отзывы"
                                Background="Transparent" BorderBrush="#4CAF50" BorderThickness="1"
                                Foreground="#4CAF50" FontSize="14" FontWeight="SemiBold" Height="40"
                                Margin="0,20,0,0" Cursor="Hand" Click="ViewAllReviewsButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>