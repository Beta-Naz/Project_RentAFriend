<Window x:Class="RentAFriendApp.Views.AuthSign.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RentAFriend - Вход" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        Keyboard.KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Современные стили для WPF без Material Design -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        VerticalAlignment="Center"
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <!-- ИЗМЕНЕНО: был #4A6FA5, стал #4CAF50 -->
                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        VerticalAlignment="Center"
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <!-- ИЗМЕНЕНО: был #4A6FA5, стал #4CAF50 -->
                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Label">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Иконка пользователя -->
        <Geometry x:Key="UserIcon">M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12ZM12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.34 14.67,14 12,14Z</Geometry>

        <!-- Иконка закрытия -->
        <Geometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>

        <!-- Иконка предупреждения -->
        <Geometry x:Key="AlertIcon">M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16</Geometry>
    </Window.Resources>

    <Border Background="White" CornerRadius="0,0,15,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <!-- Левая часть - Приветствие -->
            <!-- ИЗМЕНЕНО: был #4A6FA5, стал #4CAF50 -->
            <Border CornerRadius="0,0,0,15" Background="#4CAF50">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип и название -->
                    <StackPanel Grid.Row="0" Margin="30,40,30,0">
                        <Viewbox Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <Image Source="/Resources/Images/rentiIco.png"/>
                        </Viewbox>
                        <TextBlock Text="RentAFriend" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="Найди своего идеального компаньона" 
                                   FontSize="14" 
                                   Foreground="#E0E0E0"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Декоративный элемент -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- ИЗМЕНЕНО: был #3A5A80, стал #388E3C -->
                        <Ellipse Width="150" Height="150" Fill="#388E3C" Opacity="0.2"/>
                        <Viewbox Width="80" Height="80">
                            <Path Data="{StaticResource UserIcon}" Fill="White" Stretch="Uniform" Opacity="0.7"/>
                        </Viewbox>
                    </Grid>

                    <!-- Копирайт -->
                    <TextBlock Grid.Row="2" 
                               Text="© 2025 RentAFriend" 
                               Foreground="#E0E0E0" 
                               FontSize="12"
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>
                </Grid>
            </Border>
            <!-- Правая часть - Форма входа -->
            <Border Grid.Column="1" Background="White" CornerRadius="0,15,15,0">
                <Grid Margin="40,40,40,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и кнопка закрытия -->
                    <Grid Grid.Row="0" Margin="0,0,0,30" HorizontalAlignment="Center">
                        <TextBlock Text="Вход в аккаунт" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="#333333"/>
                    </Grid>

                    <!-- Email -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Email" 
                                       Foreground="#666666" 
                                       FontSize="13"
                                       Margin="0,0,0,5"/>
                        <TextBox x:Name="EmailTextBox"
                                       Style="{StaticResource ModernTextBox}"
                                       Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                       Tag="example@mail.ru"
                                       KeyDown="EmailTextBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Пароль -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,25">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Пароль" 
                                           Foreground="#666666" 
                                           FontSize="13"/>
                            <TextBlock 
                                           MouseDown="ForgotPasswordText_MouseDown"
                                           HorizontalAlignment="Right" 
                                           Text="Забыли пароль?"
                                           Foreground="#4CAF50"
                                           FontSize="12"
                                           Cursor="Hand">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                <!-- ИЗМЕНЕНО: был #3A5A80, стал #388E3C -->
                                                <Setter Property="Foreground" Value="#388E3C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource ModernPasswordBox}"
                                         KeyDown="PasswordBox_KeyDown"/>
                    </StackPanel>

                    <!-- Кнопка входа -->
                    <Button
                                Grid.Row="3" 
                                Content="Войти" 
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginCommand}"
                                Margin="0,0,0,20"/>

                    <!-- Сообщение об ошибке -->
                    <Border Grid.Row="4" 
                                x:Name="ErrorBorder"
                                Background="#FFF5F5" 
                                BorderBrush="#FFCDD2" 
                                BorderThickness="1"
                                CornerRadius="8" 
                                Padding="0"
                                Visibility="Collapsed"
                                Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource AlertIcon}" 
                                      Fill="#D32F2F" 
                                      Width="20" 
                                      Height="20"
                                      Margin="0,0,8,0"
                                      Stretch="Uniform"/>
                            <TextBlock Grid.Column="1" 
                                           x:Name="ErrorText" 
                                           Text="Неверный email или пароль" 
                                           Foreground="#D32F2F"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Разделитель -->
                    <Grid Grid.Row="5" Margin="0,0,0,20">
                        <Line X1="0" X2="1" Stretch="Fill" Stroke="#E0E0E0" StrokeThickness="1"/>
                        <TextBlock VerticalAlignment="Center"
                                       Text="или" 
                                       Background="White" 
                                       Padding="0"
                                       Foreground="#999999"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Кнопка регистрации -->
                    <StackPanel Grid.Row="6" VerticalAlignment="Center">
                        <TextBlock Text="Нет аккаунта?" 
                                       Foreground="#666666" 
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>
                        <Label MouseDown="CreateAccountLabel_MouseDown"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Content="Создать аккаунт" 
                                   Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <!-- Версия приложения -->
                    <TextBlock Grid.Row="7" 
                                   Text="Версия 1.0.0" 
                                   Foreground="#999999" 
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- Разделение колонок -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Border>
</Window>