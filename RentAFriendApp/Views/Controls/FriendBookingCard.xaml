<UserControl x:Class="RentAFriendApp.Views.Controls.FriendBookingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:RentAFriendApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,10"
            BorderBrush="Transparent" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="1"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Основная информация -->
            <StackPanel>
                <!-- Клиент -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#E8F5E8"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ClientInitials}" FontSize="14" FontWeight="Bold"
                                   Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding ClientName}" FontSize="15" FontWeight="SemiBold" Foreground="#333333"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ClientEmail}" FontSize="12" Foreground="#666666"/>
                            <TextBlock Text=" • " FontSize="12" Foreground="#999999"/>
                            <TextBlock Text="{Binding ClientPhone}" FontSize="12" Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Детали -->
                <Border Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Дата" FontSize="10" Foreground="#999999"/>
                            <TextBlock Text="{Binding DateDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Fill="#E0E0E0" Margin="12,4"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Время" FontSize="10" Foreground="#999999"/>
                            <TextBlock Text="{Binding TimeRange}" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Width="1" Fill="#E0E0E0" Margin="12,4"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Длительность" FontSize="10" Foreground="#999999"/>
                            <TextBlock Text="{Binding Duration}" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Место и цель -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="📍 Место" FontSize="10" Foreground="#999999"/>
                        <TextBlock Text="{Binding MeetingLocation}" FontSize="12" Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="🎯 Цель" FontSize="10" Foreground="#999999"/>
                        <TextBlock Text="{Binding Purpose}" FontSize="12" Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Создано -->
                <TextBlock FontSize="10" Foreground="#999999">
                    <Run Text="Создано: "/>
                    <Run Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"/>
                </TextBlock>
            </StackPanel>

            <!-- Правая панель: статус + сумма + действия -->
            <StackPanel Grid.Column="1" Width="160" Margin="16,0,0,0" VerticalAlignment="Top">
                <!-- Статус -->
                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding StatusBackground}"/>
                    </Border.Background>
                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Сумма -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} ₽}"
                               FontSize="18" FontWeight="Bold" Foreground="#333333"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PaymentStatusDisplay}" FontSize="10" Foreground="#666666"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Действия -->
                <Button Content="✅ Принять" Style="{StaticResource PrimaryButton}"
                        Click="BtnAccept_Click" Margin="0,0,0,6"
                        Visibility="{Binding CanAccept, Converter={StaticResource BoolToVisibility}}"/>

                <Button Content="❌ Отклонить" Style="{StaticResource DangerButton}"
                        Click="BtnReject_Click" Margin="0,0,0,6"
                        Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibility}}"/>

                <Button Content="✓ Завершить" Style="{StaticResource InfoButton}"
                        Click="BtnComplete_Click" Margin="0,0,0,6"
                        Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibility}}"/>

                <Button Content="💬 Чат" Style="{StaticResource PrimaryButton}"
                        Click="BtnChat_Click" Margin="0,0,0,6"
                        Background="#FF9800"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>