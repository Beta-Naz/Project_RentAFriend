<UserControl x:Class="RentAFriendApp.Views.Controls.MyBookingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:RentAFriendApp.Converters.Client.MyBooking"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:StatusToTextConverter x:Key="StatusToText"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:DateTimeToDateConverter x:Key="DateToDate"/>
        <converters:TimeSpanToTimeConverter x:Key="TimeToTime"/>
        <converters:PaymentStatusToColorConverter x:Key="PaymentToColor"/>
        <converters:PaymentStatusToTextConverter x:Key="PaymentToText"/>
        <converters:DurationToStringConverter x:Key="DurationToString"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PayButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="IconCancel">M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z</Geometry>
        <Geometry x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Geometry>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="White"
            CornerRadius="12"
            Padding="16"
            Margin="0,0,0,8"
            BorderBrush="Transparent"
            BorderThickness="2"
            MouseDown="RootBorder_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="1"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Дата -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Date, Converter={StaticResource DateToDate}}"
                           FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock Text="{Binding Date, StringFormat=MMM}"
                           FontSize="11" Foreground="#666666"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="32" Height="32" CornerRadius="16" Background="#E8F5E8"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding FriendInitials}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#4CAF50"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding FriendName}" FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock Text="{Binding FriendCity}" FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock HorizontalAlignment="Left" Text="{Binding Purpose}" FontSize="12" Foreground="#666666"
                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
            </StackPanel>

            <!-- Время -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding StartTime, Converter={StaticResource TimeToTime}}"
                           FontSize="14" FontWeight="SemiBold" Foreground="#333333"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="—" FontSize="10" Foreground="#999999" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EndTime, Converter={StaticResource TimeToTime}}"
                           FontSize="14" FontWeight="SemiBold" Foreground="#333333"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Длительность -->
            <TextBlock Grid.Column="3"
                       Text="{Binding Duration, Converter={StaticResource DurationToString}}"
                       FontSize="13" Foreground="#666666"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Сумма -->
            <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} ₽}"
                           FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBlock Text="{Binding PaymentStatus, Converter={StaticResource PaymentToText}}"
                           FontSize="11" Margin="0,2,0,0"
                           Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentToColor}}"/>
            </StackPanel>

            <!-- Статус -->
            <Border Grid.Column="5"
                    CornerRadius="20"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Background>
                    <SolidColorBrush Color="{Binding StatusBackground}"/>
                </Border.Background>
                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
            </Border>

            <!-- Действия -->
            <Border Grid.Column="6" Width="200" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Style="{StaticResource ActionButton}"
                Click="BtnChat_Click"
                ToolTip="Чат" Margin="0,0,4,0"
                Visibility="{Binding CanChat, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="💬" FontSize="14"/>
                    </Button>

                    <Button Style="{StaticResource ActionButton}"
                Click="BtnCancel_Click"
                ToolTip="Отменить" Margin="0,0,4,0"
                Visibility="{Binding CanBeCancelled, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource IconCancel}" Fill="#FF5252"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource ActionButton}"
                Click="BtnReview_Click"
                ToolTip="Оставить отзыв" Margin="0,0,4,0"
                Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource IconStar}" Fill="#FFC107"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Content="Оплатить"
                Style="{StaticResource PayButton}"
                Click="BtnPay_Click"
                Visibility="{Binding CanPay, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
